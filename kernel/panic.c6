#include "c6os/panic.h"
#include "c6os/log.h"
#include "c6os/port.h"

/* M0 panic：打印原因 + 环形日志 + 可选陷阱帧，然后停机。
 * host/sim 的 port_panic_halt() 直接返回，便于测试断言。 */

static u32 g_panic_count = 0;

u32 os_panic_count(void) {
    return g_panic_count;
}

void os_panic(const char *msg) {
    g_panic_count = g_panic_count + 1u;
    port_puts("\n*** PANIC: ");
    port_puts(msg);
    port_puts(" ***\n");
    port_puts("--- log ---\n");
    klog_dump();
    port_puts("--- halt ---\n");
    port_panic_halt();
}

void os_panic_frame(const char *msg, const OsTrapFrame *tf) {
    u32 i = 0;

    port_puts("\n*** PANIC: ");
    port_puts(msg);
    port_puts(" ***\n");
    kprintf("pc=%08x ps=%08x cause=%u vaddr=%08x\n",
            tf->pc, tf->ps, tf->exccause, tf->excvaddr);
    while (i < 16u) {
        kprintf("a%u=%08x", i, tf->a[i]);
        if ((i % 4u) == 3u) {
            kputs("\n");
        } else {
            kputs(" ");
        }
        i++;
    }
    port_puts("--- log ---\n");
    klog_dump();
    port_puts("--- halt ---\n");
    port_panic_halt();
}
