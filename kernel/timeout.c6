#include "c6os/timeout.h"
#include "c6os/tick.h"

typedef struct {
    u32 id;
    u32 deadline;
} OsTimeout;

static OsTimeout g_to[OS_TIMEOUT_MAX] = {0};
static u32 g_count = 0;

static int earlier(u32 a, u32 b) {
    return ((i32)(a - b)) < 0;
}

void os_timeout_init(void) {
    u32 i = 0;

    while (i < (u32)OS_TIMEOUT_MAX) {
        g_to[i].id = 0;
        g_to[i].deadline = 0;
        i++;
    }
    g_count = 0;
}

int os_timeout_cancel(u32 id) {
    u32 i = 0;

    while (i < g_count) {
        if (g_to[i].id == id) {
            u32 j = i;
            while (j + 1u < g_count) {
                g_to[j] = g_to[j + 1u];
                j++;
            }
            g_count = g_count - 1u;
            return 0;
        }
        i++;
    }
    return -1;
}

int os_timeout_add(u32 id, u32 ticks) {
    u32 deadline = (u32)os_tick_get() + ticks;
    u32 i = 0;

    (void)os_timeout_cancel(id);
    if (g_count >= (u32)OS_TIMEOUT_MAX) {
        return -1;
    }
    i = g_count;
    while (i > 0u && earlier(deadline, g_to[i - 1u].deadline)) {
        g_to[i] = g_to[i - 1u];
        i--;
    }
    g_to[i].id = id;
    g_to[i].deadline = deadline;
    g_count = g_count + 1u;
    return 0;
}

int os_timeout_pop_expired(u32 now, u32 *id) {
    u32 i = 0;

    if (g_count == 0u || id == 0) {
        return 0;
    }
    if (earlier(now, g_to[0].deadline)) {
        return 0;
    }
    *id = g_to[0].id;
    while (i + 1u < g_count) {
        g_to[i] = g_to[i + 1u];
        i++;
    }
    g_count = g_count - 1u;
    return 1;
}

u32 os_timeout_count(void) {
    return g_count;
}

u32 os_timeout_deadline_at(u32 i) {
    if (i >= g_count) {
        return 0u;
    }
    return g_to[i].deadline;
}
