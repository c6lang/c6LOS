#include "c6os/queue.h"
#include "c6os/task.h"

#define QUEUE_MAGIC 0x51E5C6A5u
#define Q_WAIT_GET 6u
#define Q_WAIT_PUT 7u

int os_queue_init_ex(OsQueue *q, void *storage, u32 cap, u32 item_size) {
    if (q == 0 || storage == 0 || cap == 0u || item_size == 0u ||
        item_size > 4096u || cap > 0xFFFFFFFFu / item_size) {
        return -1;
    }
    q->buf = (u8 *)storage;
    q->item_size = item_size;
    q->cap = cap;
    q->head = 0;
    q->tail = 0;
    q->count = 0;
    q->magic = QUEUE_MAGIC;
    q->waiters_get = 0;
    q->waiters_put = 0;
    return 0;
}

int os_queue_init(OsQueue *q, void **storage, u32 cap) {
    return os_queue_init_ex(q, (void *)storage, cap, (u32)sizeof(void *));
}

static void slot_write(OsQueue *q, u32 idx, const void *src) {
    u8 *d = q->buf + idx * q->item_size;
    const u8 *s = (const u8 *)src;

    if (q->item_size == 4u) {
        *(u32 *)d = *(const u32 *)s;
        return;
    }
    {
        u32 i = 0;
        while (i < q->item_size) {
            d[i] = s[i];
            i++;
        }
    }
}

static void slot_read(OsQueue *q, u32 idx, void *dst) {
    const u8 *s = q->buf + idx * q->item_size;
    u8 *d = (u8 *)dst;

    if (q->item_size == 4u) {
        *(u32 *)d = *(const u32 *)s;
        return;
    }
    {
        u32 i = 0;
        while (i < q->item_size) {
            d[i] = s[i];
            i++;
        }
    }
}

int os_queue_destroy(OsQueue *q) {
    if (q == 0 || q->magic != QUEUE_MAGIC) {
        return -1;
    }
    {
        u32 st = os_obj_lock();
        os_task_wake_all(q, -3);
        q->buf = 0;
    q->item_size = 0;
    q->cap = 0;
    q->head = 0;
    q->tail = 0;
        q->count = 0;
        q->magic = 0;
        os_obj_unlock(st);
    }
    return 0;
}

static u32 g_put_ok = 0;
static u32 g_put_try = 0;
static u32 g_get_ok = 0;

int os_queue_put_item(OsQueue *q, const void *item, u32 timeout) {
    if (q == 0 || q->magic != QUEUE_MAGIC || item == 0) {
        return -1;
    }
    for (;;) {
        u32 st = os_obj_lock();
        int r = 0;

        if (q->magic != QUEUE_MAGIC || q->cap == 0u) {
            os_obj_unlock(st);
            return -1;
        }
        if (q->count != q->cap) {
            g_put_try = g_put_try + 1u;
#if defined(C6OS_S3_DIAG)
            *(volatile u32 *)0x5000120Cu = g_put_try;
#endif
            slot_write(q, q->tail, item);
            q->tail = q->tail + 1u;
            if (q->tail == q->cap) {
                q->tail = 0u;
            }
            q->count = q->count + 1u;
            g_put_ok = g_put_ok + 1u;
#if defined(C6OS_S3_DIAG)
            *(volatile u32 *)0x50001208u = g_put_ok;
#endif
            (void)os_task_wake_first(q, Q_WAIT_GET, 0);
            os_obj_unlock(st);
            return 0;
        }
        r = os_task_block_prepare(q, timeout, Q_WAIT_PUT, 0u);
        os_obj_unlock(st);
        if (r != 0) {
            return r;
        }
        r = os_task_block_wait();
        if (r != 0) {
            return r;
        }
    }
}

int os_queue_put(OsQueue *q, void *item, u32 timeout) {
    return os_queue_put_item(q, (const void *)&item, timeout);
}

int os_queue_get_item(OsQueue *q, void *out, u32 timeout) {
    {
        /* §§1122：诊断计数（RTC 自初始化）。
         * 0x50000EB0+0=进入次数，+4=q 不合法次数，
         * +8=cap==0 次数，+12=阻塞次数，+16=取到消息次数。 */
        volatile u32 *c = (volatile u32 *)0x50000EB0u;
        u32 v = c[0]; if (v > 1000000u) { v = 0u; } c[0] = v + 1u;
        if (q == 0 || q->magic != QUEUE_MAGIC || out == 0) {
            u32 w = c[1]; if (w > 1000000u) { w = 0u; } c[1] = w + 1u;
            c[5] = (u32)q;
            c[6] = (q != 0) ? q->magic : 0u;
            c[7] = (u32)out;
        }
    }
    if (q == 0 || q->magic != QUEUE_MAGIC || out == 0) {
        return -1;
    }
    for (;;) {
        u32 st = os_obj_lock();
        int r = 0;

        if (q->magic != QUEUE_MAGIC || q->cap == 0u) {
            { volatile u32 *c = (volatile u32 *)0x50000EB0u;
              u32 w = c[2]; if (w > 1000000u) { w = 0u; } c[2] = w + 1u; }
            os_obj_unlock(st);
            return -1;
        }
        if (q->count != 0u) {
            { volatile u32 *c = (volatile u32 *)0x50000EB0u;
              u32 w = c[4]; if (w > 1000000u) { w = 0u; } c[4] = w + 1u; }
            slot_read(q, q->head, out);
            q->head = q->head + 1u;
            if (q->head == q->cap) {
                q->head = 0u;
            }
            q->count = q->count - 1u;
            (void)os_task_wake_first(q, Q_WAIT_PUT, 0);
            os_obj_unlock(st);
            return 0;
        }
        { volatile u32 *c = (volatile u32 *)0x50000EB0u;
          u32 w = c[3]; if (w > 1000000u) { w = 0u; } c[3] = w + 1u; }
        r = os_task_block_prepare(q, timeout, Q_WAIT_GET, 0u);
        os_obj_unlock(st);
        if (r != 0) {
            return r;
        }
        r = os_task_block_wait();
        if (r != 0) {
            return r;
        }
    }
}

void *os_queue_get(OsQueue *q, u32 timeout) {
    void *item = 0;

    if (os_queue_get_item(q, (void *)&item, timeout) != 0) {
        return 0;
    }
    return item;
}

u32 os_queue_count(OsQueue *q) {
    if (q == 0) {
        return 0;
    }
    return q->count;
}

/* 非阻塞读写：FreeRTOS/IDF 里 timeout==0 表示"立刻返回，不等待"，
 * 而我们的 timeout==0 是"永久等待"（portMAX_DELAY 映射过来的）。
 * 两者语义相反，所以单独提供这两个不做任何等待的版本。 */
int os_queue_try_get_item(OsQueue *q, void *out) {
    u32 st = 0u;
    int r = -1;

    if (q == 0 || out == 0) {
        return -1;
    }
    st = os_obj_lock();
    if (q->magic == QUEUE_MAGIC && q->cap != 0u && q->count != 0u) {
        slot_read(q, q->head, out);
        q->head = q->head + 1u;
        if (q->head == q->cap) {
            q->head = 0u;
        }
        q->count = q->count - 1u;
        (void)os_task_wake_first(q, Q_WAIT_PUT, 0);
        r = 0;
    }
    os_obj_unlock(st);
    return r;
}

int os_queue_try_put_item(OsQueue *q, const void *item) {
    u32 st = 0u;
    int r = -1;

    if (q == 0 || item == 0) {
        return -1;
    }
    st = os_obj_lock();
    if (q->magic == QUEUE_MAGIC && q->cap != 0u && q->count != q->cap) {
        slot_write(q, q->tail, item);
        q->tail = q->tail + 1u;
        if (q->tail == q->cap) {
            q->tail = 0u;
        }
        q->count = q->count + 1u;
        (void)os_task_wake_first(q, Q_WAIT_GET, 0);
        r = 0;
    }
    os_obj_unlock(st);
    return r;
}
