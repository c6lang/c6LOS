#include "c6os/task.h"
#include "c6os/log.h"
#include "c6os/panic.h"
#include "c6os/port.h"
#include "c6os/tick.h"

/* M1 调度器：16 槽静态池 + 优先级位图 + 同优先级轮转。
 * 协作 port 用 yield 触发调度；tick 时间片/抢占在抢占 port 接入。 */

static OsTask g_tasks[C6OS_MAX_TASKS] = {0};
static u32 g_next_id = 1;
static u32 g_rr = 0;
static u32 g_ready_bit = 0;
static OsTask *g_cur = 0;

static u32 ctz32(u32 x) {
    u32 n = 0;

    while ((x & 1u) == 0u) {
        x = x >> 1;
        n++;
    }
    return n;
}

static void ready_rebuild(void) {
    u32 i = 0;

    g_ready_bit = 0;
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state == (u8)OS_TASK_READY) {
            g_ready_bit = g_ready_bit | (1u << g_tasks[i].prio);
        }
        i++;
    }
}

static OsTask *sched_pick(void) {
    u32 i = 0;
    u32 prio = 0;

    ready_rebuild();
    if (g_ready_bit == 0u) {
        return 0;
    }
    prio = ctz32(g_ready_bit);
    while (i < (u32)C6OS_MAX_TASKS) {
        u32 idx = (g_rr + i) % (u32)C6OS_MAX_TASKS;
        OsTask *c = &g_tasks[idx];
        if (c->state == (u8)OS_TASK_READY && (u32)c->prio == prio) {
            g_rr = (idx + 1u) % (u32)C6OS_MAX_TASKS;
            return c;
        }
        i++;
    }
    return 0;
}

int os_task_create(const char *name, OsTaskEntry entry, void *arg,
                   u32 prio, u32 stack_size) {
    u32 i = 0;
    OsTask *t = 0;

    if (prio >= (u32)C6OS_PRIOS) {
        return -1;
    }
    if (stack_size < 512u) {
        stack_size = 512u;
    }
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state == (u8)OS_TASK_FREE) {
            t = &g_tasks[i];
            break;
        }
        i++;
    }
    if (t == 0) {
        return -2;
    }

    t->id = g_next_id;
    g_next_id++;
    t->entry = entry;
    t->arg = arg;
    t->prio = (u8)prio;
    t->stack_size = stack_size;
    t->slice = (u32)C6OS_TIMESLICE;
    t->delay_left = 0;
    t->ctx = port_task_ctx_create(entry, arg, stack_size);
    if (t->ctx == 0) {
        t->state = (u8)OS_TASK_FREE;
        return -3;
    }
    i = 0;
    while (i + 1u < (u32)C6OS_NAME_MAX && name[i] != '\0') {
        t->name[i] = name[i];
        i++;
    }
    t->name[i] = '\0';
    t->state = (u8)OS_TASK_READY;
    return (int)t->id;
}

int os_task_delete(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return -1;
    }
    if (t == g_cur) {
        t->state = (u8)OS_TASK_DEAD;
        port_task_yield();
        return 0;
    }
    if (t->ctx != 0) {
        port_task_ctx_free(t->ctx);
        t->ctx = 0;
    }
    t->state = (u8)OS_TASK_FREE;
    return 0;
}

void os_sched_tick(void) {
    u32 i = 0;

    os_tick_advance(1);
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state == (u8)OS_TASK_BLOCKED && g_tasks[i].delay_left > 0u) {
            g_tasks[i].delay_left = g_tasks[i].delay_left - 1u;
            if (g_tasks[i].delay_left == 0u) {
                g_tasks[i].state = (u8)OS_TASK_READY;
            }
        }
        i++;
    }
}

void os_task_start(void) {
    while (1) {
        OsTask *t = sched_pick();
        if (t == 0) {
            if (os_task_count() == 0) {
                break;
            }
            if (port_virtual_tick() != 0u) {
                os_sched_tick();
                continue;
            }
            port_idle();
            continue;
        }
        g_cur = t;
        t->state = (u8)OS_TASK_RUNNING;
        port_task_switch(t->ctx);
        if (t->state == (u8)OS_TASK_RUNNING) {
            t->state = (u8)OS_TASK_READY;
        }
        if (t->state == (u8)OS_TASK_DEAD) {
            port_task_ctx_free(t->ctx);
            t->ctx = 0;
            t->state = (u8)OS_TASK_FREE;
        } else if (port_task_stack_ok(t->ctx) == 0u) {
            os_panic("task stack overflow");
        }
    }
    g_cur = 0;
}

void os_task_yield(void) {
    if (g_cur == 0) {
        return;
    }
    g_cur->state = (u8)OS_TASK_READY;
    port_task_yield();
}

void os_task_delay(u32 ticks) {
    if (g_cur == 0) {
        return;
    }
    if (ticks == 0u) {
        os_task_yield();
        return;
    }
    g_cur->delay_left = ticks;
    g_cur->state = (u8)OS_TASK_BLOCKED;
    port_task_yield();
}

void os_task_exit(void) {
    if (g_cur != 0) {
        g_cur->state = (u8)OS_TASK_DEAD;
    }
    port_task_yield();
}

u32 os_task_self(void) {
    if (g_cur == 0) {
        return 0;
    }
    return g_cur->id;
}

u32 os_task_count(void) {
    u32 i = 0;
    u32 n = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state != (u8)OS_TASK_FREE) {
            n++;
        }
        i++;
    }
    return n;
}

OsTask *os_task_get(u32 id) {
    u32 i = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state != (u8)OS_TASK_FREE && g_tasks[i].id == id) {
            return &g_tasks[i];
        }
        i++;
    }
    return 0;
}
