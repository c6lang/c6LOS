#include "c6os/task.h"
#include "c6os/log.h"
#include "c6os/panic.h"
#include "c6os/port.h"
#include "c6os/tick.h"
#include "c6os/timer.h"
#include "c6os/timeout.h"

/* M1 调度器：16 槽静态池 + 优先级位图 + 同优先级轮转。
 * 协作 port 用 yield 触发调度；tick 时间片/抢占在抢占 port 接入。 */

OsTask g_tasks[C6OS_MAX_TASKS] = {0};   /* §1334 */
static u32 g_next_id = 1;
static u32 g_rr_arr[C6OS_MAX_CORES] = {0};
static OsTask *g_cur_arr[C6OS_MAX_CORES] = {0};
/* S3 专有的诊断埋点（写 RTC 慢存 / 读 xtensa ctx 内部布局）。其它 port 没有
 * 这些地址和布局，宏不开时整段不编译 —— 否则 host/x86/rv32 会在非法地址上
 * 直接崩（或链接时缺 port_cur_ctx/port_snapshot/port_switch_trace）。 */
#if defined(C6OS_S3_DIAG)
static u32 g_dbg_n = 0;        /* os_task_current_id 诊断计数 */
static u32 g_dbg_pick_n = 0;   /* 调度选择诊断计数 */
static u32 g_dbg_blk_n = 0;    /* 阻塞诊断计数 */
static u32 g_dbg_to_fires = 0;
static u32 g_snap_done = 0;    /* 一次性快照是否已做过 */
#endif

static void os_task_wake_join(u32 id);
static void (*g_mutex_release_hook)(u32 id) = 0;
static volatile u32 g_sched_lock[C6OS_MAX_CORES] = {0};
static volatile u32 g_switch_count = 0;

void os_task_set_mutex_release_hook(void (*fn)(u32 id)) {
    g_mutex_release_hook = fn;
}

static volatile u32 g_obj_lock = 0;

u32 os_obj_lock(void) {
    u32 st = port_irq_save();

#if defined(C6OS_S3)
    /* 单核 S3：关中断即可保护对象；避免每次 CAS 的函数调用开销。 */
    return st;
#else
    while (port_atomic_cas(&g_obj_lock, 0u, 1u) == 0u) {
    }
    return st;
#endif
}

void os_obj_unlock(u32 state) {
#if !defined(C6OS_S3)
    g_obj_lock = 0;
#endif
    port_irq_restore(state);
}

static void task_release_locks(u32 id) {
    if (g_mutex_release_hook != 0) {
        g_mutex_release_hook(id);
    }
}

/* 每核当前任务/轮转游标：SMP 下按 hart 隔离，单核时下标恒 0。 */
#define g_core (port_core_id() & (u32)(C6OS_MAX_CORES - 1))
#define g_rr (g_rr_arr[g_core])
#define g_cur (g_cur_arr[g_core])

static void make_ready(OsTask *t) {
#if defined(C6OS_S3_DIAG)
    *(volatile u32 *)0x50000D8Cu = *(volatile u32 *)0x50000D8Cu + 1u;
#endif
    if (t->suspend_cnt > 0u) {
        t->state = (u8)OS_TASK_SUSP;
    } else {
        t->state = (u8)OS_TASK_READY;
    }
}

static u32 g_waiters = 0;

static void unblock(OsTask *t, int result) {
#if defined(C6OS_S3_DIAG)
    port_putc('u');                    /* 谁被唤醒（§250） */
    port_putc((int)('0' + (t->id & 7u)));
#endif
    if (t->state == (u8)OS_TASK_BLOCKED && g_waiters > 0u) {
        g_waiters = g_waiters - 1u;
    }
    t->wait_obj = 0;
    t->wait_result = result;
    t->delay_left = 0;
    (void)os_timeout_cancel(t->id);
    make_ready(t);
}

static u32 ctz32(u32 x) {
    u32 n = 0;

    while ((x & 1u) == 0u) {
        x = x >> 1;
        n++;
    }
    return n;
}

static OsTask *sched_pick(u32 core) {
    u32 i = 0;
    OsTask *best = 0;
    u32 best_idx = 0;

    u32 other_idx = 0;
    OsTask *other = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        u32 idx = (g_rr + i) % (u32)C6OS_MAX_TASKS;
        OsTask *c = &g_tasks[idx];

        if (c->state == (u8)OS_TASK_READY && (u32)c->core == core) {
            if (best == 0 || (u32)c->prio < (u32)best->prio) {
                best = c;
                best_idx = idx;
            }
            /* §1503 ★★★ **除自己以外**的最优候选。
             *
             * 原来本函数只按"prio 数值最小"挑，而我们的 WiFi 主任务是
             * prio=1（全场最小）⇒ `os_task_yield_force()` 把它放回 READY
             * 之后，这里**又挑回它自己**，ppTask(prio2)/tcpip(prio2)
             * 永远拿不到 CPU。真板证据：tcpip 线程创建成功（句柄 3）
             * 却连入口第一行都没执行；`[tks]` 三个任务同时 READY。
             * 主动让出时必须换成别人跑。 */
            if (c != g_cur_arr[core]) {
                if (other == 0 || (u32)c->prio < (u32)other->prio) {
                    other = c;
                    other_idx = idx;
                }
            }
        }
        i++;
    }
    if (best == 0) {
        return 0;
    }
    if (best == g_cur_arr[core] && other != 0) {
        g_rr = (other_idx + 1u) % (u32)C6OS_MAX_TASKS;
        return other;
    }
    g_rr = (best_idx + 1u) % (u32)C6OS_MAX_TASKS;
    return best;
}

int os_task_create_on(u32 core, const char *name, OsTaskEntry entry, void *arg,
                      u32 prio, u32 stack_size) {
    u32 i = 0;
    OsTask *t = 0;

    if (core >= (u32)C6OS_MAX_CORES) {
        return -1;
    }
    if (name == 0) {
        name = "task";
    }
    if (port_in_isr() != 0u) {
        return -1;
    }
    if (prio >= (u32)C6OS_PRIOS) {
        return -1;
    }
    if (stack_size < 512u) {
        stack_size = 512u;
    }
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state == (u8)OS_TASK_FREE) {
            t = &g_tasks[i];
            break;
        }
        i++;
    }
    if (t == 0) {
        return -2;
    }

    t->id = g_next_id;
    t->magic = (u32)OS_TASK_MAGIC;
    g_next_id++;
    t->entry = entry;
    t->arg = arg;
    t->prio = (u8)prio;
    t->base_prio = (u8)prio;
    t->core = (u8)core;
    t->stack_size = stack_size;
    t->slice = (u32)C6OS_TIMESLICE;
    t->delay_left = 0;
    t->ctx = port_task_ctx_create(entry, arg, stack_size);
#ifdef S3_ONE_ABI
    port_switch_trace(7u, (u32)t->id, (u32)(void *)t->ctx);
#endif
    if (t->ctx == 0) {
        t->state = (u8)OS_TASK_FREE;
        return -3;
    }
    i = 0;
    while (i + 1u < (u32)C6OS_NAME_MAX && name[i] != '\0') {
        t->name[i] = name[i];
        i++;
    }
    t->name[i] = '\0';
    t->run_cycles = 0u;
    t->switches = 0u;
    t->state = (u8)OS_TASK_READY;
    return (int)t->id;
}

int os_task_create(const char *name, OsTaskEntry entry, void *arg,
                   u32 prio, u32 stack_size) {
    return os_task_create_on(0u, name, entry, arg, prio, stack_size);
}

int os_task_set_prio(u32 id, u32 prio) {
    OsTask *t = os_task_get(id);

    if (t == 0 || prio >= (u32)C6OS_PRIOS) {
        return -1;
    }
    t->prio = (u8)prio;
    t->base_prio = (u8)prio;
    if (t == g_cur) {
        os_task_yield();
    }
    return 0;
}

u32 os_task_get_prio(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return 0xFFFFFFFFu;
    }
    return (u32)t->prio;
}

u32 os_task_switch_count(void) {
    return g_switch_count;
}

u64 os_task_run_cycles(u32 id) {
    OsTask *t = os_task_get(id);

    return (t != 0) ? t->run_cycles : 0u;
}

u32 os_task_switches(u32 id) {
    OsTask *t = os_task_get(id);

    return (t != 0) ? t->switches : 0u;
}

u32 os_task_core(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return 0xFFFFFFFFu;
    }
    return (u32)t->core;
}

/* 某核可运行任务数（READY/RUNNING），用于观测与负载均衡。 */
u32 os_core_ready(u32 core) {
    u32 i = 0;
    u32 n = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if ((u32)t->core == core &&
            (t->state == (u8)OS_TASK_READY || t->state == (u8)OS_TASK_RUNNING)) {
            n++;
        }
        i++;
    }
    return n;
}

int os_task_set_core(u32 id, u32 core) {
    OsTask *t = os_task_get(id);

    if (t == 0 || core >= (u32)C6OS_MAX_CORES) {
        return -1;
    }
    if (t->state != (u8)OS_TASK_RUNNING && t->state != (u8)OS_TASK_SUSP) {
        return -1; /* READY/BLOCKED 任务不允许跨核搬家（避免双核同时选中） */
    }
    t->core = (u8)core;
    return 0;
}

int os_task_delete(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0 || port_in_isr() != 0u) {
        return -1;
    }
    (void)os_timeout_cancel(id);
    os_task_wake_join(id);
    task_release_locks(id);
    if (t == g_cur) {
        t->state = (u8)OS_TASK_DEAD;
        port_task_yield();
        return 0;
    }
    /* 先让其他核不再选中它，再释放 ctx。 */
    t->state = (u8)OS_TASK_FREE;
    t->magic = 0u;
    if (t->ctx != 0) {
        port_task_ctx_free(t->ctx);
        t->ctx = 0;
    }
    return 0;
}

int os_task_block_prepare(void *obj, u32 timeout, u8 kind, u32 arg) {
    u32 core = port_core_id() & (u32)(C6OS_MAX_CORES - 1);

    if (g_cur == 0 || port_in_isr() != 0u) {
        return -1;
    }
    {
        volatile u32 *bc = (volatile u32 *)0x50000EA0u;
        u32 bv = bc[0];
        if (bv > 100000u) { bv = 0u; }
        bc[0] = bv + 1u;
        bc[1] = g_cur->id;
        bc[2] = timeout;
        bc[3] = (u32)kind;
    }
    if (g_sched_lock[core] != 0u) {
        { volatile u32 *bc = (volatile u32 *)0x50000EA0u;
          u32 bv = bc[4]; if (bv > 100000u) { bv = 0u; } bc[4] = bv + 1u; }
        return -4; /* 调度锁内不允许阻塞 */
    }
#if defined(C6OS_S3_DIAG)
    {
        /* 诊断：记录每个任务最后一次阻塞的信息到 RTC 0x50001C00。
         * kind: 由调用方定义（queue/sem/event 各自一套），obj 是等待对象。
         *
         * §463：这块原来在 0x50001A00，**和 port/s3/ctx.S §452 的 yield 轨迹
         * 用的地址完全重叠**（trail 在 0x50001A00..0x50001A3F，idx 在 0x50001A40），
         * 两边互相覆盖，实测读出来是混合垃圾（一个槽里同时出现 ctx 指针和
         * sem 指针），根本没法解读。中间试过 0x50001C00，又撞上
         * wifi_glue.c:317 的信号量追踪和 console.c:493，也不行。
         * 现在放 0x50000600（0x50000600..0x5000073F 全空闲，
         * 0x50000740 起才被 wifi_glue 占用）。
         *
         * 槽格式是**每槽 5 字**（不是 4）：
         *   [+0]=obj [+1]=kind [+2]=port_cur_ctx() [+3]=g_cur->ctx [+4]=epcv
         * 4 个槽共 20 字 = 80 字节。 */
        volatile u32 *bd = (volatile u32 *)0x50000600u;
        u32 n_ = g_dbg_blk_n;
        g_dbg_blk_n = n_ + 1;
        u32 ctxv = (u32)(void *)g_cur->ctx;
        u32 spv = 0;
        u32 epcv = 0;
        if (ctxv != 0u) {
            spv = *(volatile u32 *)(ctxv + 64u);
            if (spv != 0u) { epcv = *(volatile u32 *)(spv + 60u); }
        }
        /* 按任务 id 分槽（id&3），每个任务只保留它最后一次阻塞的信息：
         * [0]=obj [1]=kind [2]=epc [3]=timeout */
        {
            /* 环形记录：把 port 视角的 ctx 一起记下来（它由
             * port_task_switch / port_set_cur_ctx 维护，是权威的），
             * 用它区分是哪个任务在阻塞，避开 g_cur->id 归属错误。 */
            u32 sl_ = (n_ & 3u) * 5u;
            bd[sl_ + 0u] = (u32)obj;
            bd[sl_ + 1u] = (u32)kind;
            bd[sl_ + 2u] = (u32)(void *)port_cur_ctx();
            bd[sl_ + 3u] = (u32)(void *)g_cur->ctx;
            bd[sl_ + 4u] = epcv;   /* 该任务被切走时保存的 EPC */
        }
    }
#endif
    g_cur->wait_obj = obj;
    g_cur->wait_kind = kind;
    g_cur->wait_arg = arg;
    g_cur->wait_bits = 0;
    g_cur->wait_result = 0;
    g_cur->delay_left = timeout;
    if (timeout == 0u) {
        /* 永久等待：先清掉本任务可能残留的超时条目。
         * 否则上一次带超时的等待留下的条目一旦到期，会把这次永久等待
         * 误唤醒成"超时"（os_task_block_wait 返回 -2），
         * 表现为调用方在 _queue_recv 上不停重试。 */
        (void)os_timeout_cancel(g_cur->id);
    }
    /* §657: 库用 portMAX_DELAY = -1 (0xFFFFFFFF) 表示"永久等待"。
     * 原来只有 timeout==0 被当成无限等待，-1 会被 os_timeout_add 算成
     * deadline = now + 0xFFFFFFFF = now-1，立刻到期 → 超时解阻塞(-2)，
     * 队列投递的 wake 被抢先，ppTask 空转（u2 连发）且第 6 条扫描消息
     * 永远不被派发。两种取值都按"无超时"处理。 */
    if (timeout != 0u && timeout != 0xFFFFFFFFu &&
        os_timeout_add(g_cur->id, timeout) != 0) {
        g_cur->wait_obj = 0;
        g_cur->delay_left = 0;
        return -3;
    }
    g_cur->state = (u8)OS_TASK_BLOCKED;
    g_waiters = g_waiters + 1u;
#if defined(C6OS_S3_DIAG)
    port_putc('b');          /* 阻塞计入 g_waiters（§250） */
#endif
    return 0;
}

int os_task_block_wait(void) {
    if (g_cur == 0) {
        return -1;
    }
#ifdef S3_NO_SWITCH
    /* §330 实验：阻塞时**不切换**，只打一个 'S' 然后原地打转。
     * 用来判定"崩溃是否由 切走→切回 这条路径引起"。 */
    port_putc('S');
    for (;;) {
        port_putc('.');
    }
#endif
    /* §§1119 ★★★★ 关键修复：**阻塞前先消费 pending tick**。
     *
     * `S3_TICK_DEFER` 下时间推进完全靠任务调 `s3_tick_consume()`。
     * 真板死锁：初始化任务 `os_task_delay(1)` 阻塞，ppTask 阻塞在
     * xphyQueue 上，**两个任务都不消费 tick** ⇒ 超时永不到期
     * ⇒ 初始化任务永远醒不来 ⇒ `pp_create_task` 不返回。
     * 真板现场：`[delay] ticks=1 t=1` 之后永远没有 `[sdel]`。
     *
     * 在这里消费，就能让它人阻塞时推进时间。 */
    { extern void s3_tick_consume(void); s3_tick_consume(); }
    port_task_yield();
    return g_cur->wait_result;
}

int os_task_block_arg(void *obj, u32 timeout, u8 kind, u32 arg) {
    if (g_cur == 0) {
        return -1;
    }
    if (port_in_isr() != 0u) {
        os_panic("block in ISR");
        return -1;
    }
    {
        u32 st = os_obj_lock();
        int r = os_task_block_prepare(obj, timeout, kind, arg);
        os_obj_unlock(st);
        if (r != 0) {
            return r;
        }
    }
    return os_task_block_wait();
}

int os_task_join(u32 id, u32 timeout) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return 0;
    }
    if (id == os_task_self()) {
        return -1;
    }
    return os_task_block_arg((void *)t, timeout, 8u, id);
}

int os_task_block(void *obj, u32 timeout, u8 kind) {
    return os_task_block_arg(obj, timeout, kind, 0);
}

u32 os_task_wait_bits(void) {
    if (g_cur == 0) {
        return 0;
    }
    return g_cur->wait_bits;
}

int os_task_wake_event(void *obj, u32 bits) {
    u32 i = 0;
    int woke = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->state == (u8)OS_TASK_BLOCKED && t->wait_obj == obj &&
            (t->wait_kind == 4u || t->wait_kind == 5u)) {
            u32 m = t->wait_arg;
            int all = (t->wait_kind == 5u);
            int hit = all ? ((bits & m) == m) : ((bits & m) != 0u);
            if (hit) {
                t->wait_bits = bits & m;
                unblock(t, 0);
                woke++;
            }
        }
        i++;
    }
    return woke;
}

u32 os_task_wake_first_id(void *obj, u8 kind, int result) {
    u32 i = 0;
    OsTask *best = 0;
#if defined(C6OS_S3_DIAG)
    /* 诊断（§250）：RTC 0x50001820 起 4 个字
     *   [0]=调用次数 [1]=命中次数 [2]=g_waiters==0 的次数 [3]=make_ready 次数 */
    {
        volatile u32 *wd = (volatile u32 *)0x50000D80u;
        wd[0] = wd[0] + 1u;
    }
#endif

    /* 不再用 g_waiters==0 做快速返回（§250）：计数器一旦与实际状态失配，
     * 这里就会把真正的等待者跳过，消息永远发不出去（真板症状：消息入队了、
     * 接收方一直不被唤醒）。直接扫任务表，代价可以忽略。 */
    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->state == (u8)OS_TASK_BLOCKED && t->wait_obj == obj &&
            t->wait_kind == kind) {
            if (best == 0 || t->prio < best->prio) {
                best = t;
            }
        }
        i++;
    }
    if (best == 0) {
#if defined(C6OS_S3_DIAG)
        port_putc('.');      /* 没匹配上等待者（§250） */
#endif
        return 0;
    }
#if defined(C6OS_S3_DIAG)
    port_putc('W');         /* 匹配上并 unblock（§250） */
    *(volatile u32 *)0x50000D84u = *(volatile u32 *)0x50000D84u + 1u;
#endif
    unblock(best, result);
    return best->id;
}

int os_task_wake_first(void *obj, u8 kind, int result) {
    return os_task_wake_first_id(obj, kind, result) != 0u ? 1 : 0;
}

void os_task_wake_all(void *obj, int result) {
    u32 i = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->state == (u8)OS_TASK_BLOCKED && t->wait_obj == obj) {
            unblock(t, result);
        }
        i++;
    }
}

int os_task_suspend(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return -1;
    }
    t->suspend_cnt = t->suspend_cnt + 1u;
    if (t->suspend_cnt == 1u) {
        if (t->state == (u8)OS_TASK_READY || t->state == (u8)OS_TASK_RUNNING) {
            t->state = (u8)OS_TASK_SUSP;
            if (t == g_cur) {
                port_task_yield();
            }
        }
    }
    return 0;
}

int os_task_resume(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0 || t->suspend_cnt == 0u) {
        return -1;
    }
    t->suspend_cnt = t->suspend_cnt - 1u;
    if (t->suspend_cnt == 0u && t->state == (u8)OS_TASK_SUSP) {
        t->state = (u8)OS_TASK_READY;
    }
    return 0;
}

int os_task_suspend_count(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return -1;
    }
    return (int)t->suspend_cnt;
}

void os_task_boost(u32 id, u32 prio) {
    OsTask *t = os_task_get(id);

    if (t != 0 && prio < (u32)t->prio) {
        t->prio = (u8)prio;
    }
}

void os_task_restore(u32 id) {
    OsTask *t = os_task_get(id);

    if (t != 0) {
        t->prio = t->base_prio;
    }
}

static void os_task_wake_join(u32 id) {
    u32 i = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->state == (u8)OS_TASK_BLOCKED && t->wait_kind == 8u &&
            t->wait_arg == id) {
            unblock(t, 0);
        }
        i++;
    }
}

extern u32 os_tick_advance1(void);
extern u32 os_timeout_pending(void);
extern u32 os_timer_pending(void);

void os_sched_tick(void) {
    u32 now = 0;
    u32 id = 0;

#if !defined(C6OS_S3)
    /* SMP：全局 tick/超时队列只由核 0 推进，避免多核各加一次。 */
    if (port_core_id() != 0u) {
        return;
    }
#endif
    now = os_tick_advance1();
#if defined(C6OS_S3_DIAG)
    if (now >= 500u && g_snap_done == 0u) {
        g_snap_done = 1u;
#ifndef S3_ONE_ABI
        port_snapshot();     /* 实现放在 port/s3/console.c（flash 里），省 IRAM */
        /* §894: 全 windowed 下这条链 s3_timer_irq→s3_win_tramp→os_sched_tick
         * →port_snapshot 是第 5 层 call8，超过 4 个窗口；port_snapshot 的
         * entry 帧触发窗口轮转错乱，返回时 retw 拿到坏 CALLINC →
         * exccause=0 / epc1=os_task_current_slot+0x68 / windowbase=0xa，
         * 恰好在 tick=500 定死。诊断改用 JTAG 读 RTC，不在此处加窗口深度。 */
#endif
    }
#endif
    if (os_timeout_pending() != 0u) {
        while (os_timeout_pop_expired(now, &id) != 0) {
            OsTask *t = os_task_get(id);
#if defined(C6OS_S3_DIAG)
            g_dbg_to_fires = g_dbg_to_fires + 1;
            if (g_dbg_to_fires < 0xFFFFFFFFu) {
                *(volatile u32 *)0x50001600u = g_dbg_to_fires;
            }
#endif
            if (t != 0 && t->state == (u8)OS_TASK_BLOCKED) {
                unblock(t, -2);
            }
        }
    }
    if (os_timer_pending() != 0u) {
        os_timer_tick();
    }
}

void *os_sched_preempt_ctx(void) {
    OsTask *t = 0;
    u32 core = port_core_id() & (u32)(C6OS_MAX_CORES - 1);

    if (g_cur == 0 || g_sched_lock[core] != 0u) {
        return g_cur != 0 ? g_cur->ctx : 0;
    }
    if (g_cur->state == (u8)OS_TASK_RUNNING) {
        make_ready(g_cur);
    }
    t = sched_pick(g_core);
    if (t == 0) {
        t = g_cur;
    }
    if (t != g_cur) {
        g_cur = t;
    }
#if defined(C6OS_S3_DIAG)
    port_switch_trace(2u, t->id, (u32)(void *)t->ctx);       /* ISR 抢占切换 */
#endif
    t->state = (u8)OS_TASK_RUNNING;
    return t->ctx;
}

void os_task_start_core(u32 core) {
    u32 me = core & (u32)(C6OS_MAX_CORES - 1);

    while (1) {
        OsTask *t = sched_pick(me);
#if defined(C6OS_S3_DIAG)
        if (t != 0) {
            /* §374：**调度热路径上不留任何 RTC 诊断写**。
             * 原来这里每次选中任务都往 RTC 慢存写 3 个字（0x50000B00，后来又
             * 撞过户、搬到 0x50001B00），而这条循环是每次上下文切换都要跑的；
             * 诊断本身在"切换帧已经坏了"的场景下会把现场搅成一锅粥
             *（§364 里 a1 恰好等于这个常量就是它造成的）。
             * 需要时用 g_dbg_pick_n 在内存里数即可（不写 RTC）。 */
            g_dbg_pick_n = g_dbg_pick_n + 1u;
        }
#endif
        if (t == 0) {
            if (os_task_count() == 0) {
                break;
            }
            if (port_virtual_tick() != 0u) {
                os_sched_tick();
                continue;
            }
            port_idle();
            continue;
        }
        g_cur_arr[me] = t;
#if defined(C6OS_S3_DIAG)
        port_switch_trace(1u, t->id, (u32)(void *)t->ctx);   /* 主循环切换 */
#endif
        t->state = (u8)OS_TASK_RUNNING;
        g_switch_count = g_switch_count + 1u;
        {
            u64 t0 = port_cycles();
            port_enter_task();
#if defined(C6OS_S3_DIAG) && !defined(S3_ONE_ABI)
            port_task_ctx_check(t->ctx);
#endif
            port_task_switch(t->ctx);
            t->run_cycles = t->run_cycles + (port_cycles() - t0);
            t->switches = t->switches + 1u;
            port_leave_task();
        }
        if (t->state == (u8)OS_TASK_RUNNING) {
            make_ready(t);
        }
        if (t->state == (u8)OS_TASK_DEAD) {
            port_task_ctx_free(t->ctx);
            t->ctx = 0;
            t->state = (u8)OS_TASK_FREE;
                } else if (port_task_stack_ok(t->ctx) == 0u) {
            os_panic("task stack overflow");
        }
    }
    g_cur_arr[me] = 0;
    g_rr_arr[me] = 0;
}

void os_task_start(void) {
    g_waiters = 0;
    os_task_start_core(0u);
}

void os_task_lock(void) {
    u32 core = port_core_id() & (u32)(C6OS_MAX_CORES - 1);

    g_sched_lock[core] = g_sched_lock[core] + 1u;
}

void os_task_unlock(void) {
    u32 core = port_core_id() & (u32)(C6OS_MAX_CORES - 1);

    if (g_sched_lock[core] != 0u) {
        g_sched_lock[core] = g_sched_lock[core] - 1u;
    }
}

void os_task_yield(void) {
    u32 core = port_core_id() & (u32)(C6OS_MAX_CORES - 1);

    if (g_cur == 0 || g_sched_lock[core] != 0u) {
        return;
    }
#if defined(C6OS_S3)
    if (os_task_count() <= 1u) {
        return;
    }
#endif
    make_ready(g_cur);
    port_task_yield();
}

/* §§1470 ★★★★ **强制让出，忽略 `g_sched_lock`。**
 *
 * `os_task_yield()` 开头就有 `if (g_sched_lock[core] != 0u) return;`。
 * 而 lwIP 的 `tcpip_thread` 在 `osi_queue_recv` 里忙等时**正处于调度锁内**
 * ⇒ 让出被吞掉 ⇒ 同优先级的 `ppTask`（READY）永远拿不到 CPU。
 * 真板任务表实证：id1=`ppTask`(state=READY)、id2=`tcpip_thread`(state=RUNNING)。
 * ppTask 是 IDF WiFi 的**发送引擎**，它不跑 ⇒ probe/auth/assoc 全部发不出去。
 *
 * `os_task_delay()` 也靠不住：超时表满时它退化成 `os_task_yield()`（§1082），
 * 同样被锁吞掉。 */
void os_task_yield_force(void) {
    if (g_cur == 0) {
        return;
    }
    make_ready(g_cur);
    port_task_yield();
}

void os_task_delay(u32 ticks) {
    if (g_cur == 0) {
        return;
    }
    /* §1076：在任务上下文里补 tick（实现放 flash，IRAM 只多一条 call0）。 */
    { extern void s3_tick_consume(void); s3_tick_consume(); }
    if (port_in_isr() != 0u) {
        os_panic("delay in ISR");
        return;
    }
    if (ticks == 0u) {
        os_task_yield();
        return;
    }
    /* §735: portMAX_DELAY (-1 = 0xFFFFFFFF) 是 FreeRTOS 的"永久等待"。
     * os_task_block_prepare() 早就把这个值和 0 同等对待（§657），但这里漏了：
     * os_timeout_add(id, 0xFFFFFFFF) 算出 deadline = now-1，下一个 tick 立刻到期
     * → unblock(t,-2) → 库在 osi_task_delay 里无限重试（u2 连发、g_rc_n 冻结）。
     * 两种取值都按"无超时"处理，并清掉残留的超时条目。 */
    if (ticks == 0xFFFFFFFFu) {
        (void)os_timeout_cancel(g_cur->id);
        g_cur->delay_left = 0u;
        g_cur->state = (u8)OS_TASK_BLOCKED;
        port_task_yield();
        return;
    }
    g_cur->delay_left = ticks;
    /* §§1118 ★★★★ 关键修复：**不能直接阻塞睡下去**。
     *
     * `S3_TICK_DEFER` 下时间推进完全靠任务调 `s3_tick_consume()`。
     * 但一旦所有任务都阻塞了（真板：初始化任务睡 1 tick，
     * ppTask 阻塞在 xphyQueue 上），**没有任何任务去消费 tick**，
     * 超时永不到期 ⇒ 初始化任务永远醒不来 ⇒ `pp_create_task` 不返回。
     * 真板现场：最后一行 `[delay] ticks=1 t=1`，之后永远没有 `[sdel]`。
     *
     * 所以当前任务要么阻塞并依赖别人推进时间，要么自己推进。
     * 这里用自旋：反复 `s3_tick_consume()` 直到 `delay_left` 归零。
     * 代价是延时期间占 CPU，但在只有两个任务、延时又很短的初始化阶段完全可接受。 */
    if (os_timeout_add(g_cur->id, ticks) != 0) {
        /* ★★★ §1082：超时表满时也必须让出 CPU（否则永不切换任务）。 */
        g_cur->delay_left = 0;
        os_task_yield();
        return;
    }
#ifdef S3_DELAY_SPIN
    /* §§1483 ★★★★★ **把§1118 只写在注释里的"自旋"真正实现**。
     *
     * 真板铁证：`[swp] n=1 recv=0 yld=0` —— `s3_timer_sweep()`
     * 只被调用**一次**。它是 `s3_wifi_scan` 里那个 60 轮
     * 扫描等待循环每轮都调的 ⇒ **循环只跑 1 轮就卡死**，
     * 卡在 `s3_w2c_task_delay(100u)` 里再也醒不来。
     *
     * 原因正是 §1118 说的：`S3_TICK_DEFER` 下时间推进靠任务调
     * `s3_tick_consume()`；一旦当前任务阻塞睡下去、其余任务也都在
     * 阻塞，**没有任何人推进 tick ⇒ 超时永不到期 ⇒ 永远醒不来**。
     *
     * 这里改成自旋：反复 `s3_tick_consume()` 直到延迟到期；
     * 并**每 8 次强制让出一次**，让 ppTask 也能拿到 CPU。
     * 这样既不会死锁，也不会把同优先级任务饿死。 */
    /* §§1484 纯忙等版本：**不调任何函数**，只把延迟消费掉就返回。
     * 上一版自旋里调 `s3_tick_consume()`（会进入调度切换），
     * 真板仍然 `[swp] n=1` 不动 ⇒ 疑点就在那次切换里。
     * 这里完全不碰调度器，保证延迟一定返回。 */
    {
        u32 n = 0u;
        u32 lim = ticks * 200u + 200u;
        while (n < lim) { n = n + 1u; }
        g_cur->delay_left = 0u;
        return;
    }
#endif
    g_cur->state = (u8)OS_TASK_BLOCKED;
    port_task_yield();
}

void os_task_exit(void) {
    if (g_cur != 0) {
        u32 id = g_cur->id;
        g_cur->state = (u8)OS_TASK_DEAD;
        os_task_wake_join(id);
        task_release_locks(id);
    }
    port_task_yield();
}

u32 os_task_self(void) {
    if (g_cur == 0) {
        return 0;
    }
    return g_cur->id;
}

u32 os_task_count(void) {
    u32 i = 0;
    u32 n = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state != (u8)OS_TASK_FREE) {
            n++;
        }
        i++;
    }
    return n;
}

u32 os_task_info(u32 idx, u32 *id, u32 *prio, u32 *state, char *name, u32 cap) {
    OsTask *t = 0;
    u32 i = 0;

    if (idx >= (u32)C6OS_MAX_TASKS) {
        return 0;
    }
    t = &g_tasks[idx];
    if (t->state == (u8)OS_TASK_FREE || t->magic != (u32)OS_TASK_MAGIC) {
        return 0;
    }
    if (id != 0) { *id = t->id; }
    if (prio != 0) { *prio = (u32)t->prio; }
    if (state != 0) { *state = (u32)t->state; }
    if (name != 0 && cap > 0u) {
        while (i + 1u < cap && t->name[i] != '\0') {
            name[i] = t->name[i];
            i++;
        }
        name[i] = '\0';
    }
    return 1u;
}

OsTask *os_task_get(u32 id) {
    u32 i = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state != (u8)OS_TASK_FREE &&
            g_tasks[i].magic == (u32)OS_TASK_MAGIC && g_tasks[i].id == id) {
            return &g_tasks[i];
        }
        i++;
    }
    return 0;
}

/* 当前任务 id（0 表示还没进调度）。WiFi 的 OSI 适配层需要它：
 * 闭源库用 `_task_get_current_task()` 的返回值和 `_task_create()` 写回的
 * 句柄比较，判断"我现在是不是在 WiFi 任务里"。两边必须是同一个口径 ——
 * 都用任务 id，不能用栈指针之类的东西糊弄。 */

u32 os_task_current_id(void) {
    if (g_cur == 0) {
        return 0;
    }
#if defined(C6OS_S3_DIAG)
    {
        u32 a0id = 0;
        u32 a1id = 0;
        volatile u32 *d = 0;
        u32 k = 0;

        if (g_cur_arr[0] != 0) {
            a0id = g_cur_arr[0]->id;
        }
        if (g_cur_arr[1] != 0) {
            a1id = g_cur_arr[1]->id;
        }
        d = (volatile u32 *)0x500004A0u;
        k = g_dbg_n & 3;
        g_dbg_n = g_dbg_n + 1;
        d[k * 4] = g_cur->id;
        d[k * 4 + 1] = a0id;
        d[k * 4 + 2] = a1id;
        d[k * 4 + 3] = (u32)(void *)g_cur;
    }
#endif
    return g_cur->id;
}

/* 诊断探针：按任务 id 取若干内部字段（what: 0=state 1=wait_kind
 * 2=wait_obj 3=wait_result 4=suspend_cnt）。WiFi 死锁排查用，
 * 让一个低优先级监控任务把结果写进 RTC 慢存，复位后直接 read-mem。 */
u32 os_task_probe(u32 id, u32 what) {
    u32 i = 0;
    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->magic == OS_TASK_MAGIC && t->id == id) {
            if (what == 0u) { return (u32)t->state; }
            if (what == 1u) { return (u32)t->wait_kind; }
            if (what == 2u) { return (u32)(void *)t->wait_obj; }
            if (what == 3u) { return (u32)t->wait_result; }
            if (what == 4u) { return t->suspend_cnt; }
            return 0u;
        }
        i++;
    }
    return 0xFFFFFFFFu;
}

/* 任务总数（含已结束），监控任务遍历用 */
u32 os_task_total(void) {
    return (u32)C6OS_MAX_TASKS;
}

/* 稳定的"当前任务身份"：直接取 g_tasks[] 下标，不依赖 g_cur->id。
 * 闭源库大量用 `_task_get_current_task()` 做身份判断，
 * 之前用 g_cur->id 出现过"同一任务返回不同 id"的读数（见 docs/wifi-plan.md
 * §133/§140），换成表下标可以从构造上保证一致：
 * `_task_create` 写回的句柄与 `_task_get_current_task()` 用的是同一口径。 */
u32 os_task_current_slot(void) {
    u32 i = 0;
    u32 cid = 0;
    if (g_cur == 0) {
        return 0u;
    }
    /* 注意：.c6 编译出来的 `&g_tasks[i]` 取址不可靠（见 docs §114），
     * 这里改成比较 id（g_tasks[] 只在 os_task_create 里分配，id 唯一）。 */
    cid = g_cur->id;
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].magic == OS_TASK_MAGIC && g_tasks[i].id == cid) {
            return i + 1u;      /* 0 保留给"无当前任务" */
        }
        i++;
    }
    return 0u;
}

/* 按 g_tasks 下标取任务 id（_task_create 写句柄用） */
u32 os_task_slot_of_id(u32 id) {
    u32 i = 0;
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].magic == OS_TASK_MAGIC && g_tasks[i].id == id) {
            return i + 1u;
        }
        i++;
    }
    return 0u;
}
