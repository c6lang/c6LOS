#include "c6os/task.h"
#include "c6os/log.h"
#include "c6os/panic.h"
#include "c6os/port.h"
#include "c6os/tick.h"
#include "c6os/timer.h"
#include "c6os/timeout.h"

/* M1 调度器：16 槽静态池 + 优先级位图 + 同优先级轮转。
 * 协作 port 用 yield 触发调度；tick 时间片/抢占在抢占 port 接入。 */

static OsTask g_tasks[C6OS_MAX_TASKS] = {0};
static u32 g_next_id = 1;
static u32 g_rr_arr[C6OS_MAX_CORES] = {0};
static u32 g_ready_bit = 0;
static OsTask *g_cur_arr[C6OS_MAX_CORES] = {0};

/* 每核当前任务/轮转游标：SMP 下按 hart 隔离，单核时下标恒 0。 */
#define g_core (port_core_id() & (u32)(C6OS_MAX_CORES - 1))
#define g_rr (g_rr_arr[g_core])
#define g_cur (g_cur_arr[g_core])

static void make_ready(OsTask *t) {
    if (t->suspend_cnt > 0u) {
        t->state = (u8)OS_TASK_SUSP;
    } else {
        t->state = (u8)OS_TASK_READY;
    }
}

static void unblock(OsTask *t, int result) {
    t->wait_obj = 0;
    t->wait_result = result;
    t->delay_left = 0;
    (void)os_timeout_cancel(t->id);
    make_ready(t);
}

static u32 ctz32(u32 x) {
    u32 n = 0;

    while ((x & 1u) == 0u) {
        x = x >> 1;
        n++;
    }
    return n;
}

static void ready_rebuild(u32 core) {
    u32 i = 0;

    g_ready_bit = 0;
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state == (u8)OS_TASK_READY && (u32)g_tasks[i].core == core) {
            g_ready_bit = g_ready_bit | (1u << g_tasks[i].prio);
        }
        i++;
    }
}

static OsTask *sched_pick(u32 core) {
    u32 i = 0;
    u32 prio = 0;

    ready_rebuild(core);
    if (g_ready_bit == 0u) {
        return 0;
    }
    prio = ctz32(g_ready_bit);
    while (i < (u32)C6OS_MAX_TASKS) {
        u32 idx = (g_rr + i) % (u32)C6OS_MAX_TASKS;
        OsTask *c = &g_tasks[idx];
        if (c->state == (u8)OS_TASK_READY && (u32)c->prio == prio &&
            (u32)c->core == core) {
            g_rr = (idx + 1u) % (u32)C6OS_MAX_TASKS;
            return c;
        }
        i++;
    }
    return 0;
}

int os_task_create_on(u32 core, const char *name, OsTaskEntry entry, void *arg,
                      u32 prio, u32 stack_size) {
    u32 i = 0;
    OsTask *t = 0;

    if (core >= (u32)C6OS_MAX_CORES) {
        return -1;
    }
    if (prio >= (u32)C6OS_PRIOS) {
        return -1;
    }
    if (stack_size < 512u) {
        stack_size = 512u;
    }
    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state == (u8)OS_TASK_FREE) {
            t = &g_tasks[i];
            break;
        }
        i++;
    }
    if (t == 0) {
        return -2;
    }

    t->id = g_next_id;
    t->magic = (u32)OS_TASK_MAGIC;
    g_next_id++;
    t->entry = entry;
    t->arg = arg;
    t->prio = (u8)prio;
    t->base_prio = (u8)prio;
    t->core = (u8)core;
    t->stack_size = stack_size;
    t->slice = (u32)C6OS_TIMESLICE;
    t->delay_left = 0;
    t->ctx = port_task_ctx_create(entry, arg, stack_size);
    if (t->ctx == 0) {
        t->state = (u8)OS_TASK_FREE;
        return -3;
    }
    i = 0;
    while (i + 1u < (u32)C6OS_NAME_MAX && name[i] != '\0') {
        t->name[i] = name[i];
        i++;
    }
    t->name[i] = '\0';
    t->state = (u8)OS_TASK_READY;
    return (int)t->id;
}

int os_task_create(const char *name, OsTaskEntry entry, void *arg,
                   u32 prio, u32 stack_size) {
    return os_task_create_on(0u, name, entry, arg, prio, stack_size);
}

u32 os_task_core(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return 0xFFFFFFFFu;
    }
    return (u32)t->core;
}

int os_task_delete(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return -1;
    }
    (void)os_timeout_cancel(id);
    if (t == g_cur) {
        t->state = (u8)OS_TASK_DEAD;
        port_task_yield();
        return 0;
    }
    if (t->ctx != 0) {
        port_task_ctx_free(t->ctx);
        t->ctx = 0;
    }
    t->state = (u8)OS_TASK_FREE;
    t->magic = 0u;
    return 0;
}

int os_task_block_arg(void *obj, u32 timeout, u8 kind, u32 arg) {
    if (g_cur == 0) {
        return -1;
    }
    if (port_in_isr() != 0u) {
        os_panic("block in ISR");
        return -1;
    }
    g_cur->wait_obj = obj;
    g_cur->wait_kind = kind;
    g_cur->wait_arg = arg;
    g_cur->wait_bits = 0;
    g_cur->wait_result = 0;
    g_cur->delay_left = timeout;
    g_cur->state = (u8)OS_TASK_BLOCKED;
    if (timeout != 0u) {
        (void)os_timeout_add(g_cur->id, timeout);
    }
    port_task_yield();
    return g_cur->wait_result;
}

int os_task_join(u32 id, u32 timeout) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return 0;
    }
    if (id == os_task_self()) {
        return -1;
    }
    return os_task_block_arg((void *)t, timeout, 8u, id);
}

int os_task_block(void *obj, u32 timeout, u8 kind) {
    return os_task_block_arg(obj, timeout, kind, 0);
}

u32 os_task_wait_bits(void) {
    if (g_cur == 0) {
        return 0;
    }
    return g_cur->wait_bits;
}

int os_task_wake_event(void *obj, u32 bits) {
    u32 i = 0;
    int woke = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->state == (u8)OS_TASK_BLOCKED && t->wait_obj == obj &&
            (t->wait_kind == 4u || t->wait_kind == 5u)) {
            u32 m = t->wait_arg;
            int all = (t->wait_kind == 5u);
            int hit = all ? ((bits & m) == m) : ((bits & m) != 0u);
            if (hit) {
                t->wait_bits = bits & m;
                unblock(t, 0);
                woke++;
            }
        }
        i++;
    }
    return woke;
}

int os_task_wake_first(void *obj, u8 kind, int result) {
    u32 i = 0;
    OsTask *best = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->state == (u8)OS_TASK_BLOCKED && t->wait_obj == obj &&
            t->wait_kind == kind) {
            if (best == 0 || t->prio < best->prio) {
                best = t;
            }
        }
        i++;
    }
    if (best == 0) {
        return 0;
    }
    unblock(best, result);
    return 1;
}

int os_task_suspend(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return -1;
    }
    t->suspend_cnt = t->suspend_cnt + 1u;
    if (t->suspend_cnt == 1u) {
        if (t->state == (u8)OS_TASK_READY || t->state == (u8)OS_TASK_RUNNING) {
            t->state = (u8)OS_TASK_SUSP;
            if (t == g_cur) {
                port_task_yield();
            }
        }
    }
    return 0;
}

int os_task_resume(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0 || t->suspend_cnt == 0u) {
        return -1;
    }
    t->suspend_cnt = t->suspend_cnt - 1u;
    if (t->suspend_cnt == 0u && t->state == (u8)OS_TASK_SUSP) {
        t->state = (u8)OS_TASK_READY;
    }
    return 0;
}

int os_task_suspend_count(u32 id) {
    OsTask *t = os_task_get(id);

    if (t == 0) {
        return -1;
    }
    return (int)t->suspend_cnt;
}

void os_task_boost(u32 id, u32 prio) {
    OsTask *t = os_task_get(id);

    if (t != 0 && prio < (u32)t->prio) {
        t->prio = (u8)prio;
    }
}

void os_task_restore(u32 id) {
    OsTask *t = os_task_get(id);

    if (t != 0) {
        t->prio = t->base_prio;
    }
}

static void os_task_wake_join(u32 id) {
    u32 i = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        OsTask *t = &g_tasks[i];
        if (t->state == (u8)OS_TASK_BLOCKED && t->wait_kind == 8u &&
            t->wait_arg == id) {
            unblock(t, 0);
        }
        i++;
    }
}

void os_sched_tick(void) {
    u32 now = 0;
    u32 id = 0;

    os_tick_advance(1);
    now = (u32)os_tick_get();
    while (os_timeout_pop_expired(now, &id) != 0) {
        OsTask *t = os_task_get(id);
        if (t != 0 && t->state == (u8)OS_TASK_BLOCKED) {
            unblock(t, -2);
        }
    }
    os_timer_tick();
}

void *os_sched_preempt_ctx(void) {
    OsTask *t = 0;

    if (g_cur == 0) {
        return 0;
    }
    if (g_cur->state == (u8)OS_TASK_RUNNING) {
        make_ready(g_cur);
    }
    t = sched_pick(g_core);
    if (t == 0) {
        t = g_cur;
    }
    if (t != g_cur) {
        g_cur = t;
        t->state = (u8)OS_TASK_RUNNING;
    }
    return t->ctx;
}

void os_task_start_core(u32 core) {
    u32 me = core & (u32)(C6OS_MAX_CORES - 1);

    while (1) {
        OsTask *t = sched_pick(me);
        if (t == 0) {
            if (os_task_count() == 0) {
                break;
            }
            if (port_virtual_tick() != 0u) {
                os_sched_tick();
                continue;
            }
            port_idle();
            continue;
        }
        g_cur_arr[me] = t;
        t->state = (u8)OS_TASK_RUNNING;
        port_enter_task();
        port_task_switch(t->ctx);
        port_leave_task();
        if (t->state == (u8)OS_TASK_RUNNING) {
            make_ready(t);
        }
        if (t->state == (u8)OS_TASK_DEAD) {
            port_task_ctx_free(t->ctx);
            t->ctx = 0;
            t->state = (u8)OS_TASK_FREE;
                } else if (port_task_stack_ok(t->ctx) == 0u) {
            os_panic("task stack overflow");
        }
    }
    g_cur_arr[me] = 0;
    g_rr_arr[me] = 0;
}

void os_task_start(void) {
    os_task_start_core(0u);
}

void os_task_yield(void) {
    if (g_cur == 0) {
        return;
    }
    make_ready(g_cur);
    port_task_yield();
}

void os_task_delay(u32 ticks) {
    if (g_cur == 0) {
        return;
    }
    if (port_in_isr() != 0u) {
        os_panic("delay in ISR");
        return;
    }
    if (ticks == 0u) {
        os_task_yield();
        return;
    }
    g_cur->delay_left = ticks;
    g_cur->state = (u8)OS_TASK_BLOCKED;
    (void)os_timeout_add(g_cur->id, ticks);
    port_task_yield();
}

void os_task_exit(void) {
    if (g_cur != 0) {
        u32 id = g_cur->id;
        g_cur->state = (u8)OS_TASK_DEAD;
        os_task_wake_join(id);
    }
    port_task_yield();
}

u32 os_task_self(void) {
    if (g_cur == 0) {
        return 0;
    }
    return g_cur->id;
}

u32 os_task_count(void) {
    u32 i = 0;
    u32 n = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state != (u8)OS_TASK_FREE) {
            n++;
        }
        i++;
    }
    return n;
}

u32 os_task_info(u32 idx, u32 *id, u32 *prio, u32 *state, char *name, u32 cap) {
    OsTask *t = 0;
    u32 i = 0;

    if (idx >= (u32)C6OS_MAX_TASKS) {
        return 0;
    }
    t = &g_tasks[idx];
    if (t->state == (u8)OS_TASK_FREE) {
        return 0;
    }
    if (id != 0) { *id = t->id; }
    if (prio != 0) { *prio = (u32)t->prio; }
    if (state != 0) { *state = (u32)t->state; }
    if (name != 0 && cap > 0u) {
        while (i + 1u < cap && t->name[i] != '\0') {
            name[i] = t->name[i];
            i++;
        }
        name[i] = '\0';
    }
    return 1u;
}

OsTask *os_task_get(u32 id) {
    u32 i = 0;

    while (i < (u32)C6OS_MAX_TASKS) {
        if (g_tasks[i].state != (u8)OS_TASK_FREE &&
            g_tasks[i].magic == (u32)OS_TASK_MAGIC && g_tasks[i].id == id) {
            return &g_tasks[i];
        }
        i++;
    }
    return 0;
}
