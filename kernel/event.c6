#include "c6os/event.h"
#include "c6os/task.h"

#define EVENT_MAGIC 0xC6E50003u

int os_event_init(OsEvent *e) {
    if (e == 0) {
        return -1;
    }
    e->bits = 0;
    e->magic = EVENT_MAGIC;
    return 0;
}

static int event_hit(u32 bits, u32 mask, u32 mode) {
    if (mode == OS_EVENT_ALL) {
        return (bits & mask) == mask;
    }
    return (bits & mask) != 0u;
}

int os_event_set(OsEvent *e, u32 bits) {
    if (e == 0 || e->magic != EVENT_MAGIC) {
        return -1;
    }
    e->bits = e->bits | bits;
    os_task_wake_event(e, e->bits);
    return 0;
}

int os_event_clear(OsEvent *e, u32 bits) {
    if (e == 0 || e->magic != EVENT_MAGIC) {
        return -1;
    }
    e->bits = e->bits & ~bits;
    return 0;
}

u32 os_event_get(OsEvent *e) {
    if (e == 0) {
        return 0;
    }
    return e->bits;
}

u32 os_event_wait(OsEvent *e, u32 mask, u32 mode, u32 timeout) {
    if (e == 0 || e->magic != EVENT_MAGIC) {
        return 0;
    }
    if (event_hit(e->bits, mask, mode)) {
        return e->bits & mask;
    }
    {
        u8 kind = (mode == OS_EVENT_ALL) ? 5u : 4u;
        int r = os_task_block_arg(e, timeout, kind, mask);
        if (r != 0) {
            return 0;
        }
        return os_task_wait_bits();
    }
}
