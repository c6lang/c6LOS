/* kernel/net/netif_x86.c6 —— 把 port 层的 e1000 挂到 NetIf 上（M10-2）
 *
 * 只有 x86 参考目标编这个文件（Makefile 里跟着 C6OS_NET=1 一起加），
 * S3 用的是闭源 WiFi，另一套。
 *
 * 收包是轮询：NetIfPollX86() 把网卡 RX 环里现成的帧搬进 NetBuf 再喂给
 * NetIfInput（协议栈在任务上下文里跑，不在 IRQ 里跑）。
 */
#include "c6os/types.h"
#include "c6os/string.h"
#include "c6os/port.h"
#include "los/los_typedef.h"
#include "los/net.h"

static INT32 netif_x86_link(LosNetIf *nif, LosNetBuf *p)
{
    INT32 rc = 0;

    (void)nif;
    rc = port_net_send((const VOID *)&p->data[p->off], p->len);
    NetBufFree(p);
    return rc;
}

LosNetIf *NetIfAttachX86(VOID)
{
    LosNetIf *nif = (LosNetIf *)0;
    UINT8 mac[LOS_ETH_ALEN] = {0};

    if (port_net_init() != 0) {
        return (LosNetIf *)0;
    }
    nif = NetIfAlloc("eth0");
    if (nif == (LosNetIf *)0) {
        return (LosNetIf *)0;
    }
    port_net_mac((UINT8 *)&mac[0]);
    NetIfSetMac(nif, (const UINT8 *)&mac[0]);
    NetIfSetLink(nif, netif_x86_link);
    return nif;
}

UINT32 NetIfPollX86(LosNetIf *nif)
{
    LosNetBuf *p = (LosNetBuf *)0;
    UINT32 n = 0u;
    INT32 len = 0;

    if (nif == (LosNetIf *)0) {
        return 0u;
    }
    n = 0u;
    while (n < 32u) {
        p = NetBufAlloc((UINT32)LOS_NET_HDR_ROOM, 0u);
        if (p == (LosNetBuf *)0) {
            return n;
        }
        len = port_net_recv((VOID *)&p->data[p->off],
                           (UINT32)(LOS_NET_BUF_SIZE - LOS_NET_HDR_ROOM));
        if (len <= 0) {
            NetBufFree(p);
            return n;
        }
        p->len = (UINT32)len;
        (void)NetIfInput(nif, p);
        n = n + 1u;
    }
    return n;
}
