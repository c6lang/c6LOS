#include "c6os/config.h"
#include "c6os/types.h"
#include "c6os/tick.h"

/* §§1334：全局化，由 ISR 推进。 */
u64 g_c6os_ticks = 0;
u64 os_tick_get(void) { return g_c6os_ticks; }
void os_tick_advance(u32 n) { g_c6os_ticks = g_c6os_ticks + (u64)n; }
u32 os_tick_advance1(void) { return (u32)g_c6os_ticks; }

u32 os_tick_hz(void) {
    return (u32)C6OS_TICK_HZ;
}

u64 os_ms_to_ticks(u64 ms) {
    if (ms == 0u) {
        return 0u;
    }
    return (ms * (u64)C6OS_TICK_HZ + 999u) / 1000u;
}

u64 os_ticks_to_ms(u64 ticks) {
    return (ticks * 1000u) / (u64)C6OS_TICK_HZ;
}
