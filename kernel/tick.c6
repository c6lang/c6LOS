#include "c6os/config.h"
#include "c6os/types.h"
#include "c6os/tick.h"

static u64 g_ticks = 0;

u64 os_tick_get(void) {
    return g_ticks;
}

void os_tick_advance(u32 n) {
    g_ticks = g_ticks + (u64)n;
}

u32 os_tick_hz(void) {
    return (u32)C6OS_TICK_HZ;
}

u64 os_ms_to_ticks(u64 ms) {
    return (ms * (u64)C6OS_TICK_HZ) / 1000u;
}

u64 os_ticks_to_ms(u64 ticks) {
    return (ticks * 1000u) / (u64)C6OS_TICK_HZ;
}
