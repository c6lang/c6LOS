#include "c6os/timer.h"
#include "c6os/tick.h"

#define TIMER_MAGIC 0xC6E50007u
#define TIMER_MAX 16u

static OsTimer *g_timers[TIMER_MAX] = {0};

int os_timer_init(OsTimer *t, u32 period, int periodic, OsTimerCb cb, void *arg) {
    u32 i = 0;

    if (t == 0 || cb == 0 || period == 0u) {
        return -1;
    }
    i = 0;
    while (i < TIMER_MAX) {
        if (g_timers[i] != 0 && g_timers[i] == t) {
            return -3;
        }
        i++;
    }
    t->period = period;
    t->expire = 0;
    t->cb = cb;
    t->arg = arg;
    t->active = 0;
    t->periodic = (u8)(periodic != 0 ? 1 : 0);
    t->magic = TIMER_MAGIC;
    i = 0;
    while (i < TIMER_MAX) {
        if (g_timers[i] == 0) {
            g_timers[i] = t;
            return 0;
        }
        i++;
    }
    t->magic = 0;
    return -2;
}

int os_timer_start(OsTimer *t) {
    if (t == 0 || t->magic != TIMER_MAGIC) {
        return -1;
    }
    t->expire = (u32)os_tick_get() + t->period;
    t->active = 1;
    return 0;
}

int os_timer_deinit(OsTimer *t) {
    u32 i = 0;

    if (t == 0 || t->magic != TIMER_MAGIC) {
        return -1;
    }
    while (i < TIMER_MAX) {
        if (g_timers[i] == t) {
            g_timers[i] = 0;
        }
        i++;
    }
    t->active = 0;
    t->cb = 0;
    t->arg = 0;
    t->magic = 0;
    return 0;
}

int os_timer_stop(OsTimer *t) {
    if (t == 0 || t->magic != TIMER_MAGIC) {
        return -1;
    }
    t->active = 0;
    return 0;
}

void os_timer_tick(void) {
    u32 i = 0;
    u32 now = (u32)os_tick_get();

    while (i < TIMER_MAX) {
        OsTimer *t = g_timers[i];
        if (t != 0 && t->active != 0u && (i32)(now - t->expire) >= 0) {
            OsTimerCb cb = t->cb;
            void *arg = t->arg;
            if (t->periodic != 0u) {
                t->expire = t->expire + t->period;
            } else {
                t->active = 0;
            }
            cb(arg);
        }
        i++;
    }
}
