#include "los/los_mem.h"
#include "c6os/heap.h"

#define LOS_MEM_MAX 4u

typedef struct {
    OsHeap heap;
    void *pool;
    u8 used;
} LosMemPool;

static LosMemPool g_pools[LOS_MEM_MAX] = {0};

static LosMemPool *mem_get(void *pool) {
    u32 i = 0;

    while (i < LOS_MEM_MAX) {
        if (g_pools[i].used != 0u && g_pools[i].pool == pool) {
            return &g_pools[i];
        }
        i++;
    }
    return 0;
}

UINT32 LOS_MemInit(VOID *pool, UINT32 size) {
    u32 i = 0;

    if (pool == 0 || size < 64u) {
        return 1u;
    }
    if (mem_get(pool) != 0) {
        return 2u; /* 同一 pool 重复初始化 */
    }
    while (i < LOS_MEM_MAX) {
        if (g_pools[i].used == 0u) {
            os_heap_init(&g_pools[i].heap, pool, (u32)size);
            if (g_pools[i].heap.magic != OS_HEAP_MAGIC) {
                return 3u;
            }
            g_pools[i].pool = pool;
            g_pools[i].used = 1u;
            return 0u;
        }
        i++;
    }
    return 4u; /* 池句柄表满 */
}

VOID *LOS_MemAlloc(VOID *pool, UINT32 size) {
    LosMemPool *p = mem_get(pool);

    if (p == 0) {
        return 0;
    }
    return os_heap_alloc(&p->heap, (u32)size);
}

UINT32 LOS_MemFree(VOID *pool, VOID *ptr) {
    LosMemPool *p = mem_get(pool);

    if (p == 0 || ptr == 0) {
        return 1u;
    }
    return (os_heap_free(&p->heap, ptr) == 0) ? 0u : 2u;
}

UINT32 LOS_MemUsed(VOID *pool) {
    LosMemPool *p = mem_get(pool);

    if (p == 0) {
        return 0u;
    }
    return (UINT32)os_heap_used(&p->heap);
}
