#include "c6os/task.h"
#include "c6os/port.h"

static u32 g_order[8] = {0};
static u32 g_idx = 0;
static u32 g_seen = 0xFFFFFFFFu;

static void rec(void *arg) {
    u32 p = (u32)arg;

    if (g_idx < 8u) {
        g_order[g_idx] = p;
        g_idx++;
    }
    g_seen = p;
}

int main(void) {
    u32 p = 0;
    int a = 0;
    int b = 0;
    int c = 0;

    /* 位图选择：31/5/10 三个就绪任务，应按 5、10、31 运行。 */
    a = os_task_create("p31", rec, (void *)31u, 31u, 8192u);
    b = os_task_create("p5", rec, (void *)5u, 5u, 8192u);
    c = os_task_create("p10", rec, (void *)10u, 10u, 8192u);
    if (a <= 0 || b <= 0 || c <= 0) {
        port_puts("FAIL: create set\n");
        return 1;
    }
    os_task_start();
    if (g_order[0] != 5u || g_order[1] != 10u || g_order[2] != 31u) {
        port_puts("FAIL: bitmap order\n");
        return 2;
    }

    /* 32 个优先级逐个验证。 */
    while (p < 32u) {
        g_seen = 0xFFFFFFFFu;
        if (os_task_create("one", rec, (void *)p, p, 8192u) <= 0) {
            port_puts("FAIL: create one\n");
            return 3;
        }
        os_task_start();
        if (g_seen != p) {
            port_puts("FAIL: prio run\n");
            return 4;
        }
        p++;
    }
    port_puts("PASS: 32 priorities\n");
    return 0;
}
