/* t_s3_irom14.c6 —— 逐页探测 IROM 数据读：0x42000000 / 0x42010000 / 0x42020000 / 0x42030000
 * 我们镜像烧在 flash 0x20000，bootloader 把 MMU[0]=2(页2)、MMU[3]=3(页3)。
 * 期望：0x42000000 读回 flash 0x20000 的头 4 字节 = 0x1f0206e9（我们的镜像头）。
 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

void s3_win_call_log(const char *s);

void os_main(void)
{
    s3_beacon(0u, 0xB0000014u);

    s3_beacon(1u, *(volatile u32 *)0x42000000u);   /* 页0 -> flash 0x20000 */
    s3_beacon(2u, *(volatile u32 *)0x42010000u);   /* 页1 */
    s3_beacon(3u, *(volatile u32 *)0x42030000u);   /* 页3 -> flash 0x30000 (期望 0x7b004136) */
    for (;;) { }
}
