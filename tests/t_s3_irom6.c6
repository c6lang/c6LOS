/* t_s3_irom6.c6 —— 做成"普通 flash 镜像"后，ROM 引导时会替我们建好 MMU+cache，
 * 这时直接调用 flash 里的函数应该能返回 42。
 * 判据：slot0=0xB0000003(进入)，slot1=0xF100002A(成功，低字节=42)。 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

u32 s3_win_call_flash42(void);

void os_main(void)
{
    u32 v = 0u;

    s3_beacon(0u, 0xB0000003u);

    /* 把 SPI_MEM 的 cache 读配置改成"原厂能跑 IROM 的固件"里的值 */
    os_reg_wr(0x60002008u, 0x00608000u);
    os_reg_wr(0x60002014u, 0x00030103u);
    s3_beacon(2u, os_reg_rd(0x60002008u));

    /* 0) TRM §17 SYSTEM_CACHE_CONTROL_REG(0x60026048): bit0=ICACHE_CLK_ON bit2=DCACHE_CLK_ON
     *    这两个时钟位如果没打开，cache 根本无法访问外部存储器 —— 先读、再打开。 */
    s3_beacon(1u, os_reg_rd(0x60026048u));
    os_reg_wr(0x60026048u, os_reg_rd(0x60026048u) | 0x5u);   /* bit0 + bit2 */

    /* 1) 手写 MMU 表项（补 valid 位）2) 用寄存器做 I-cache sync（ROM 那个函数会挂） */
    os_reg_wr(0x600C500Cu, 0x4000u | 3u);
    os_reg_wr(0x600C4088u, 0x1u);              /* ICACHE_SYNC_CTRL: 启动 sync */
    { u32 guard = 0u;
      while (guard < 200000u) {
          if ((os_reg_rd(0x600C4088u) & 0x2u) != 0u) { break; }
          guard = guard + 1u;
      }
      s3_beacon(3u, (os_reg_rd(0x600C4088u) & 0x2u) | (guard << 8)); }

    v = s3_win_call_flash42();
    s3_beacon(1u, 0xF1000000u | (v & 0xFFu));
    for (;;) { }
}
