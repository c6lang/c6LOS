/* t_s3_lcd_slow.c6 —— 用很慢的 bit-bang 时钟（约 500kHz~1MHz）驱动面板，
 * 命令字节走的是修好后的通路（cmd 也走 bb_write）。
 * 若这块屏对上升沿/电平转换器有要求，慢时钟应该能见效。
 */

#include "c6os/port.h"
#include "c6os/gfx.h"

#define W 240u
#define H 240u

void s3_lcd_init(void);
void s3_lcd_use_bitbang(u32 on);
void s3_lcd_set_bb_pad(u32 n);
void s3_lcd_fill(u16 color);
void s3_lcd_blit(const u16 *fb, u32 w, u32 h);
void s3_lcd_bl(u32 on);
void s3_lcd_delay(u32 n);

static u16 g_fb[W * H] = {0};
static OsGfx g;

static void puts_(const char *s)
{
    while (*s != '\0') { port_putc(*s); s++; }
}

static void put_u32_(u32 v)
{
    char b[12] = {0};
    int i = 0;
    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v = v / 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

void os_main(void)
{
    puts_("c6os lcd SLOW bitbang\n");
    s3_lcd_use_bitbang(1u);
    s3_lcd_set_bb_pad(40u);          /* 每半周期多空转 40 次 -> 约 500kHz */
    s3_lcd_init();
    s3_lcd_bl(1u);
    puts_("init done (slow)\n");

    os_gfx_init(&g, g_fb, W, H);
    os_gfx_fill_rect(&g, 0, 0, (int)W, (int)H, 0xF800u);
    os_gfx_text16(&g, 20, 60, "SLOW CLOCK", 0xFFFFu);
    os_gfx_text16(&g, 20, 90, "C6OS", 0xFFFFu);

    for (;;) {
        u64 t0 = port_cycles();
        u32 cyc = 0;

        s3_lcd_fill(0xF800u);
        cyc = (u32)(port_cycles() - t0) / 1000u;
        puts_("red   ");
        put_u32_(cyc);
        puts_("k-cyc\n");
        s3_lcd_delay(6000000u);

        t0 = port_cycles();
        s3_lcd_fill(0x07E0u);
        cyc = (u32)(port_cycles() - t0) / 1000u;
        puts_("green ");
        put_u32_(cyc);
        puts_("k-cyc\n");
        s3_lcd_delay(6000000u);

        t0 = port_cycles();
        s3_lcd_fill(0x001Fu);
        cyc = (u32)(port_cycles() - t0) / 1000u;
        puts_("blue  ");
        put_u32_(cyc);
        puts_("k-cyc\n");
        s3_lcd_delay(6000000u);

        t0 = port_cycles();
        s3_lcd_blit(g_fb, W, H);
        cyc = (u32)(port_cycles() - t0) / 1000u;
        puts_("text  ");
        put_u32_(cyc);
        puts_("k-cyc\n");
        s3_lcd_delay(8000000u);
    }
}
