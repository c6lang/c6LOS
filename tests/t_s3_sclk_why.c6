/* t_s3_sclk_why.c6 —— 查 SCLK 引脚为何没有边沿：把 GPIO 使能位、OUT_SEL、
 * IO_MUX 原值打出来，同时用 PCNT 对照数 SCLK(9) 与 MOSI(10) 的边沿。 */

#include "c6os/port.h"

#define PCNT_BASE 0x60017000u
#define SPI2 0x60024000u

void s3_lcd_init(void);
int s3_spi_end(void);
u32 s3_reg32(u32 addr);
void s3_reg_wr(u32 addr, u32 v);
void s3_lcd_delay(u32 n);

static void puts_(const char *s)
{
    while (*s != '\0') { port_putc(*s); s++; }
}

static void hex8_(u32 v)
{
    const char *h = "0123456789abcdef";
    int i = 8;
    while (i > 0) { i--; port_putc((int)h[(v >> (i * 4)) & 0xFu]); }
}

static void put_u32_(u32 v)
{
    char b[12] = {0};
    int i = 0;
    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v = v / 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

static void pcnt_cfg(void)
{
    s3_reg_wr(0x600C0018u, s3_reg32(0x600C0018u) | (1u << 10));
    s3_reg_wr(0x600C0020u, s3_reg32(0x600C0020u) & ~(1u << 10));
    s3_reg_wr(PCNT_BASE + 0x00u, (1u << 18));
    s3_reg_wr(PCNT_BASE + 0x04u, 0u);
    s3_reg_wr(PCNT_BASE + 0x08u, 0u);
}

static void pcnt_map(u32 pin)
{
    s3_reg_wr(0x60004000u + 0x154u + 4u * 33u, (pin & 0x3Fu) | (1u << 6));
    s3_reg_wr(0x60009000u + 0x04u + 4u * pin, s3_reg32(0x60009000u + 0x04u + 4u * pin) | (1u << 9));
}

static u32 count_edges(u32 pin)
{
    pcnt_map(pin);
    s3_reg_wr(PCNT_BASE + 0x60u, 1u);
    s3_reg_wr(PCNT_BASE + 0x60u, 0u);
    /* 64 字节、慢时钟 */
    s3_reg_wr(SPI2 + 0x0Cu, (9u << 18) | (63u << 12) | (31u << 6) | 31u);
    s3_reg_wr(SPI2 + 0x1Cu, 64u * 8u - 1u);
    s3_reg_wr(SPI2 + 0x00u, (1u << 23));
    while ((s3_reg32(SPI2 + 0x00u) & (1u << 23)) != 0u) { }
    s3_reg_wr(SPI2 + 0x00u, (1u << 24));
    while ((s3_reg32(SPI2 + 0x00u) & (1u << 24)) != 0u) { }
    return s3_reg32(PCNT_BASE + 0x30u) & 0xFFFFu;
}

void os_main(void)
{
    puts_("c6os sclk why\n");
    s3_lcd_init();
    puts_("GPIO_ENABLE=");
    hex8_(s3_reg32(0x60004020u));
    puts_("\n");
    puts_("outsel9=");
    hex8_(s3_reg32(0x60004000u + 0x554u + 36u));
    puts_(" outsel10=");
    hex8_(s3_reg32(0x60004000u + 0x554u + 40u));
    puts_("\n");
    puts_("iomux9=");
    hex8_(s3_reg32(0x60009000u + 0x04u + 36u));
    puts_(" iomux10=");
    hex8_(s3_reg32(0x60009000u + 0x04u + 40u));
    puts_("\n");

    pcnt_cfg();

    /* 对照1：把 GPIO9 当普通输出，软件翻转 100 次，PCNT 应数到 ≈100 */
    s3_reg_wr(0x60004000u + 0x554u + 36u, 0x100u);   /* 走 GPIO_OUT */
    s3_reg_wr(0x60004000u + 0x24u, 1u << 9);
    pcnt_map(9u);
    s3_reg_wr(PCNT_BASE + 0x60u, 1u);
    s3_reg_wr(PCNT_BASE + 0x60u, 0u);
    {
        u32 i = 0;
        while (i < 100u) {
            s3_reg_wr(0x60004000u + 0x0Cu, 1u << 9);   /* OUT_W1TC = 低 */
            s3_reg_wr(0x60004000u + 0x08u, 1u << 9);   /* OUT_W1TS = 高 */
            i++;
        }
    }
    puts_("gpio9 sw toggle edges=");
    put_u32_(s3_reg32(PCNT_BASE + 0x30u) & 0xFFFFu);
    puts_("\n");

    /* 对照2：装 0x5555 数据再数 MOSI 与 SCLK */
    {
        u32 i = 0;
        for (i = 0; i < 16u; i++) { s3_reg_wr(SPI2 + 0x98u + 4u * i, 0x55555555u); }
    }
    /* 恢复 SCLK 走 FSPICLK */
    s3_reg_wr(0x60004000u + 0x554u + 36u, 101u);
    s3_reg_wr(0x60004000u + 0x24u, 1u << 9);
    puts_("edges sclk(9)=");
    put_u32_(count_edges(9u));
    puts_(" mosi(10)=");
    put_u32_(count_edges(10u));
    puts_("\n");

    for (;;) {
        s3_lcd_delay(4000000u);
        puts_(".");
    }
}
