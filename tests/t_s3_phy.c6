/* t_s3_phy.c6 —— PHY 初始化（M1），只靠 USB 串口就能自证结果。
 *
 * 思路：PHY 初始化会把内部 USB PHY 抢走导致 USB-CDC 掉枚举，所以**结果不在本轮读**：
 *   本轮：把 5 个步骤的结果写进 RTC 信标（掉电域，掉电才丢）
 *   下次上电：os_main 一开始就先把上一轮的信标打印出来（这时 USB 还活着）
 *             然后再跑一轮 PHY。
 * 读法：上电后直接看串口即可。
 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

u32 s3_win_call_phy_step(u32 step);
u32 s3_win_call_phy_funcs(void);
void s3_win_call_log(const char *s);

static void pstr(const char *s) { s3_win_call_log(s); }

static void phex(u32 v)
{
    char b[11] = {0};
    int i = 2;
    int sh = 28;
    const char *h = "0123456789abcdef";

    b[0] = '0'; b[1] = 'x';
    while (sh >= 0) {
        b[i] = h[(v >> (u32)sh) & 0xFu];
        i++;
        sh -= 4;
    }
    b[10] = '\0';
    pstr(b);
}

void os_main(void)
{
    u32 step = 1u;
    u32 rc = 0u;

    /* 点亮 LCD 背光（GPIO13）——LEAN 构建里没有 panel.c，直接操作 GPIO。
     * 这样即使在 PHY 死掉、串口失联之后，屏幕也是亮的，肉眼就能确认板子在跑。 */
    os_reg_wr(0x60009034u, (os_reg_rd(0x60009034u) & ~(7u << 12)) | (1u << 12));
    os_reg_wr(0x60004554u, 0x100u);      /* GPIO13 的 OUT_SEL = 普通 GPIO */
    os_reg_wr(0x60004024u, 1u << 13);    /* 输出使能 */
    os_reg_wr(0x60004008u, 1u << 13);    /* 背光常亮 */

    /* 先把上一轮（可能是被看门狗复位掉的）信标打出来：RTC 域在 CPU 复位时不清，
     * 只有真断电才丢，所以看门狗复位能让我们看到"卡在第几步"。 */
    pstr("prev: step=");
    phex(*(volatile u32 *)0x600080C0u);
    pstr(" rc=");
    phex(*(volatile u32 *)0x600080C4u);
    pstr("\n");

    /* 给 step5（射频校准）套 3 秒看门狗：万一挂住，会自动复位重跑，
     * 于是下一轮的 prev 就能告诉我们它卡在 0xE5。 */
    os_reg_wr(0x6001F064u, 0x50D83AA1u);
    os_reg_wr(0x6001F04Cu, 240000000u);
    os_reg_wr(0x6001F048u, (1u << 31) | (2u << 29) | (1u << 15));
    os_reg_wr(0x6001F064u, 0u);

    /* 重新武装 RTC 超级看门狗（SWD）：应用若在 PHY 校准里挂住，约 3.5 秒后
     * 整片复位重跑；RTC 域不清，所以下一轮的 prev 会显示卡在 0xE5。 */
    os_reg_wr(0x600080B8u, 0x8F1D312Au);
    os_reg_wr(0x600080B4u, os_reg_rd(0x600080B4u) & ~(1u << 30));
    os_reg_wr(0x600080B8u, 0u);

    /* 2) 本轮重新跑一遍 */
    s3_beacon(2u, s3_win_call_phy_funcs());
    while (step <= 5u) {
        s3_beacon(0u, 0xE0u + step);
        pstr("step ");
        phex(step);
        pstr(" ... ");
        rc = s3_win_call_phy_step(step);
        s3_beacon(1u, rc);
        s3_beacon(2u, s3_win_call_phy_funcs());
        pstr("rc=");
        phex(rc);
        pstr(" tab=");
        phex(s3_win_call_phy_funcs());
        pstr("\n");
        step = step + 1u;
    }
    s3_beacon(0u, 0xEFu);

    /* 3) 如果 PHY 没把 USB 弄死，这里还能直接把结果打出来 */
    pstr("this run: rc=");
    phex(rc);
    pstr(" g_phyFuns=");
    phex(s3_win_call_phy_funcs());
    pstr("\n");

    for (;;) {
        volatile u32 i = 0;

        while (i < 2000000u) { i = i + 1u; }
    }
}
