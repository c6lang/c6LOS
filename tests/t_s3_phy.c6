/* t_s3_phy.c6 —— 安全探测 ROM 的 PHY 函数表入口（结果只写 RTC 信标）。
 *
 * 信标：
 *   slot0 = 0xF1 表示开始探测
 *   slot1 = phy_get_romfuncs() 的返回值
 *   slot2 = 若返回值像个指针，则取 *(返回值)（表指针的常见形态）
 *   slot3 = 最终 g_phyFuns 的值
 */
#include "c6os/types.h"
#include "c6os/port.h"

u32 s3_win_phy_romfuncs_ret(void);
u32 s3_win_call_phy_funcs(void);
u32 s3_win_phy_step(u32 step);

void os_main(void)
{
    u32 r = 0u;
    u32 d = 0u;

    s3_beacon(0u, 0xF1u);
    r = s3_win_phy_romfuncs_ret();
    s3_beacon(1u, r);
    if (r >= 0x3FC00000u && r < 0x3FD00000u) {
        d = *(volatile u32 *)r;
    }
    s3_beacon(2u, d);
    (void)s3_win_phy_step(2u);          /* 这一步会把表填进 g_phyFuns */
    s3_beacon(3u, s3_win_call_phy_funcs());
    s3_beacon(0u, 0xF2u);

    for (;;) {
        volatile u32 i = 0;

        while (i < 2000000u) { i = i + 1u; }
    }
}
