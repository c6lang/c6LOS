/* t_s3_phy.c6 —— PHY 初始化分步诊断，结果**只写 RTC 信标**（崩溃也不丢）。
 *
 * 信标约定：
 *   0x600080C0 slot0 = 当前步骤号（0xE1..0xE5 = step1..5，0xEF = 全部完成）
 *   0x600080C4 slot1 = 该步骤的返回值
 *   0x600080C8 slot2 = g_phyFuns（PHY 函数表指针）的内容
 *   0x600080CC slot3 = port_init / _start 的标记
 * 读法： ./tools/beacon.sh
 */
#include "c6os/types.h"
#include "c6os/port.h"

u32 s3_win_call_phy_step(u32 step);
u32 s3_win_call_phy_funcs(void);
u32 s3_win_find_phytab(void);

void os_main(void)
{
    u32 step = 1u;
    u32 rc = 0u;

    s3_beacon(3u, s3_win_find_phytab());      /* 扫描出来的表地址 */
    s3_beacon(2u, s3_win_call_phy_funcs());   /* 调用前的表 */

    while (step <= 5u) {
        s3_beacon(0u, 0xE0u + step);
        rc = s3_win_call_phy_step(step);
        s3_beacon(1u, rc);
        s3_beacon(2u, s3_win_call_phy_funcs());
        step = step + 1u;
    }

    s3_beacon(0u, 0xEFu);
    for (;;) {
        volatile u32 i = 0;

        while (i < 1000000u) { i = i + 1u; }
    }
}
