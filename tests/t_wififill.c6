/* WiFi 启动测试。
 *
 * 配置填写和 esp_wifi_init_internal 的调用都在 C 侧（port/s3/wifi_glue.c 的
 * s3_wifi_bringup），这里只负责：开 I-cache → PHY 初始化 → 触发 → 报告。
 * 之前这段逻辑写在 .c6 里，但 .c6 生成的代码在跨函数调用时会丢失局部变量
 * （配置块指针变成了字符串地址），导致库里读到垃圾 cfg。
 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
extern u32 s3_win_call_flash42(void);
extern u32 s3_win_call_cache_invalidate(void);
extern u32 s3_win_call_bringup(void);
extern u32 s3_win_call_calls_ptr(void);
extern u32 s3_win_call_cfg_ptr(void);
extern u32 s3_win_call_phy_cal(void);
extern u32 s3_win_call_phy_enable(void);
extern void s3_win_call_log(const char *s);

void os_main(void)
{
    u32 rc = 0u;
    s3_beacon(0u, 0xB0000210u);
    os_icache_enable();
    s3_win_call_cache_invalidate();
    s3_beacon(1u, s3_win_call_flash42());       /* 期望 42 */

    s3_win_call_log("M0 phy start\n");
    s3_win_call_phy_cal();
    s3_win_call_phy_enable();
    s3_beacon(0u, 0xB0000212u);                 /* PHY 初始化完成 */

    s3_win_call_log("M1 bringup\n");
    rc = s3_win_call_bringup();
    s3_win_call_log("M2 bringup returned\n");

    s3_beacon(0u, rc);                          /* 期望 0 = OK */
    s3_beacon(1u, s3_win_call_calls_ptr());
    for (;;) { }
}
