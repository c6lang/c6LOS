#include "c6os/types.h"
#include "c6os/task.h"
#include "c6os/port.h"

static char order[8] = {0};
static u32 n = 0;

static void ta(void *arg) {
    order[n] = 'A';
    n++;
    os_task_yield();
    order[n] = 'a';
    n++;
}

static void tb(void *arg) {
    order[n] = 'B';
    n++;
    os_task_yield();
    order[n] = 'b';
    n++;
}

void os_main(void) {
    int a = 0;
    int b = 0;

    port_init();
    port_puts("c6os rv32 sched test\n");
    a = os_task_create("a", ta, 0, 1u, 4096u);
    b = os_task_create("b", tb, 0, 1u, 4096u);
    if (a <= 0 || b <= 0) {
        port_puts("FAIL: create\n");
        return;
    }
    os_task_start();
    order[n] = '\0';
    port_puts("order: ");
    port_puts(order);
    port_puts("\n");
    if (order[0] == 'A' && order[1] == 'B' && order[2] == 'a' && order[3] == 'b') {
        port_puts("PASS: rv32 sched\n");
    } else {
        port_puts("FAIL: rv32 sched\n");
    }
}
