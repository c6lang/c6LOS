/* S3 双核：core1 进入内核调度器，两核各跑一个任务。 */
#include "c6os/types.h"
#include "c6os/task.h"
#include "c6os/port.h"

extern int s3_core1_start_mode(u32 mode);

static void p32(u32 v)
{
    char b[12] = {0};
    int i = 0;

    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v = v / 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

static volatile u32 g_c1_count;
static volatile u32 g_c1_prid;

static void c1_task(void *arg) {
    (void)arg;
    g_c1_prid = port_core_id();
    while (1) {
        g_c1_count++;
        os_task_yield();
    }
}

static void c0_task(void *arg) {
    u32 guard = 0;
    (void)arg;
    while (g_c1_count < 1000u) {
        guard++;
        if (guard > 2000000u) {
            port_puts("FAIL: s3 smp timeout\n");
            port_reboot();
        }
        os_task_yield();
    }
    if (g_c1_prid == 1u) {
        port_puts("PASS: s3 smp core1 scheduler\n");
    } else {
        port_puts("FAIL: s3 smp prid\n");
    }
    port_reboot();
}

void os_main(void) {
    port_init();
    port_puts("c6os s3 smp test\n");
    {
        int id1 = os_task_create_on(1u, "c1", c1_task, 0, 1u, 2048u);
        int id0 = os_task_create_on(0u, "c0", c0_task, 0, 1u, 2048u);
        port_puts("ids=");
        p32((u32)id1);
        port_puts(",");
        p32((u32)id0);
        port_puts("\n");
    }
    port_puts("start core1\n");
    (void)s3_core1_start_mode(1u);
    port_puts("core0 sched\n");
    os_task_start_core(0u);
    port_puts("core0 sched returned\n");
}
