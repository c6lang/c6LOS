/* H1: 读 cache 错误状态寄存器，定位失败发生在哪一层 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
void s3_win_call_log(const char *s);
static void pstr(const char *s) { s3_win_call_log(s); }
static void phex(u32 v)
{
    char b[11] = {0}; int i = 2; int sh = 28; const char *h = "0123456789abcdef";
    b[0] = '0'; b[1] = 'x';
    while (sh >= 0) { b[i] = h[(v >> (u32)sh) & 0xFu]; i++; sh -= 4; }
    b[10] = '\0'; pstr(b); pstr("\n");
}
void os_main(void)
{
    u32 v = 0u;
    s3_beacon(0u, 0xB0000040u);

    /* 1) 清计数器与状态 */
    os_reg_wr(0x600C40C4u, 0x3u);          /* 计数清 */
    os_reg_wr(0x600C40E4u, 0x3Fu);         /* ILG 状态清 */
    os_reg_wr(0x600C40F0u, 0x1Fu);         /* CORE0_ACS 状态清 */

    /* 2) 基线：MMU 表项 + 各控制寄存器 */
    pstr("mmu3=");    phex(os_reg_rd(0x600C500Cu));
    pstr("icache=");  phex(os_reg_rd(0x600C4060u));
    pstr("ctrlsys="); phex(os_reg_rd(0x600C0048u));   /* H7: SYSTEM_CACHE_CONTROL */
    pstr("shutI=");   phex(os_reg_rd(0x600C4064u));
    pstr("shutD=");   phex(os_reg_rd(0x600C4004u));

    /* 3) 触发一次 IROM 读 */
    v = *(volatile u32 *)0x42030000u;
    pstr("read="); phex(v);
    s3_beacon(2u, v);

    /* 4) 读状态：失败到底发生在哪一层 */
    pstr("ilg_st=");   phex(os_reg_rd(0x600C40E4u));
    pstr("acs_st=");   phex(os_reg_rd(0x600C40F0u));
    pstr("mmu_vaddr=");phex(os_reg_rd(0x600C4124u));
    pstr("mmu_cont="); phex(os_reg_rd(0x600C4120u));
    pstr("ibus_cnt="); phex(os_reg_rd(0x600C40CCu));
    pstr("ibus_mis="); phex(os_reg_rd(0x600C40C8u));
    pstr("dbus_cnt="); phex(os_reg_rd(0x600C40D8u));
    pstr("dbus_mis="); phex(os_reg_rd(0x600C40D0u));
    for (;;) { }
}
