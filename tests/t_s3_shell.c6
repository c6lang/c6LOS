#include "c6os/port.h"
#include "c6os/task.h"
#include "c6os/heap.h"
#include "c6os/shell.h"

static u8 g_mem[1024] = {0};
static OsHeap g_heap;
static char g_line[80] = {0};

static void shell_task(void *arg) {
    u32 n = 0;
    (void)arg;
    os_shell_bind_heap(&g_heap);
    port_puts("shell ready\nshell> ");
    while (1) {
        int c = port_getc();
        if (c < 0) {
            port_delay_ms(5u);
            continue;
        }
        if (c == '\r' || c == '\n') {
            port_puts("\n");
            g_line[n] = '\0';
            if (n > 0u) {
                (void)os_shell_exec(g_line);
            }
            n = 0;
            port_puts("shell> ");
        } else if (c == 8 || c == 127) {
            if (n > 0u) { n--; port_puts("\b \b"); }
        } else if (n + 1u < sizeof(g_line)) {
            g_line[n] = (char)c;
            n++;
            port_putc(c);
        }
    }
}

void os_main(void) {
    os_sys_heap_init(g_mem, (u32)sizeof(g_mem));
    os_shell_bind_heap(&g_heap);
    if (os_task_create("shell", shell_task, 0, 2u, 4096u) <= 0) {
        port_puts("FAIL: shell create\n");
        return;
    }
    os_task_start();
    for (;;) { }
}
