#include "c6os/event.h"
#include "c6os/task.h"
#include "c6os/port.h"

static char order[16] = {0};
static u32 n = 0;
static OsEvent ev = {0};

static void wa(void *arg) {
    u32 b = os_event_wait(&ev, 3u, OS_EVENT_ANY, 0);
    if (b == 2u) {
        order[n] = 'A';
        n++;
    }
}

static void wb(void *arg) {
    order[n] = 'B';
    n++;
    os_event_set(&ev, 2u);
}

static void we(void *arg) {
    u32 b = os_event_wait(&ev, 3u, OS_EVENT_ALL, 0);
    if (b == 3u) {
        order[n] = 'E';
        n++;
    }
}

static void wf(void *arg) {
    order[n] = 'F';
    n++;
    os_event_set(&ev, 1u);
    os_event_set(&ev, 2u);
}

static int expect(const char *want) {
    u32 i = 0;
    while (want[i] != '\0') {
        if (order[i] != want[i]) {
            return 0;
        }
        i++;
    }
    return order[i] == '\0';
}

int main(void) {
    if (os_event_init(&ev) != 0) {
        return 1;
    }
    if (os_task_create("a", wa, 0, 1, 4096) <= 0) {
        return 2;
    }
    if (os_task_create("b", wb, 0, 1, 4096) <= 0) {
        return 3;
    }
    os_task_start();
    order[n] = '\0';
    if (!expect("BA")) {
        return 4;
    }

    n = 0;
    order[0] = '\0';
    os_event_clear(&ev, 0xFFFFFFFFu);
    if (os_task_create("e", we, 0, 1, 4096) <= 0) {
        return 5;
    }
    if (os_task_create("f", wf, 0, 1, 4096) <= 0) {
        return 6;
    }
    os_task_start();
    order[n] = '\0';
    if (!expect("FE")) {
        port_puts("FAIL: event all ");
        port_puts(order);
        port_puts("\n");
        return 7;
    }

    os_event_set(&ev, 3u);
    os_event_clear(&ev, 1u);
    if (os_event_get(&ev) != 2u) {
        return 8;
    }
    port_puts("PASS: event\n");
    return 0;
}
