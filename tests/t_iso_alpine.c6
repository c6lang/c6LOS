/* tests/t_iso_alpine.c6 —— M12：Alpine（musl 动态链接）容器的 init
 *
 * 和 M11-3 的 t_iso_docker.c6 是同一套流程，但这次跑的是**真实的发行版根
 * 文件系统**，而且要跑到底：
 *
 *   1. rootfs（cpio）有 7.8MB——引导块必须能把它搬到 0x00800000
 *      （走 int 15h AH=87h 那条路，unreal mode 走不通，见 cd0.S 的注释）；
 *   2. 文件系统里的符号链接是真链接（cpio 的 S_IFLNK 条目），/bin/sh 就是
 *      -> /bin/busybox。这里故意走 /bin/sh 而不是 /bin/busybox，顺便验收
 *      fs_find 的链接解析；
 *   3. 串口接上行规程（lx_tty_init），0 号 fd 变成真终端，于是 busybox sh
 *      认为自己交互式（tcgetattr 成功）并打印提示符，能读命令。
 *
 * 之后 libc.musl 的映射、重定位、符号解析全是 ld.so 自己的事——
 * 内核不为动态链接写一行代码（M9-L4 定下的规矩，这里原样复用）。
 */
#include "c6os/types.h"
#include "c6os/string.h"
#include "c6os/port.h"
#include "c6os/vfs.h"
#include "c6os/linux_abi.h"
#include "c6os/linux_proc.h"      /* lx_tty_init 等行规程声明（M12） */
#include "los/los_typedef.h"
#include "los/los_fs.h"
#include "los/los_block.h"
#if C6OS_NET
#include "los/net.h"
#include "los/sal.h"
#endif

#define BOOTINFO_PA    0x7000u
#define BOOTINFO_MAGIC 0x53493643u
#define FAT_LBA        0u

static OsFsPart g_part = {0};

/* 交给 Alpine /bin/sh 的脚本，作为 `sh -c` 的第三个 argv。
 *
 * argv 不再需要包装函数：c6 现在把"指针数组 + 字符串字面量/具名数组"的
 * 静态初始化生成对了。以前这类全局量里的指针槽是 0，靠挂在 global_ctors 上
 * 的构造函数在启动时补 —— 裸内核不跑构造函数，于是取出来是野指针，busybox
 * 拿到的 argv[1] 不是 "-c"，退回"从 stdin 读脚本"卡在串口上。这张表能生效
 * 本身就是那次修复的端到端检验（kernel 里没有 C 运行时）。
 * 脚本刻意覆盖四件事：往终端写、读内核信息、遍历目录、写 /data 再读回。 */
#ifndef C6OS_ALPINE_INTERACTIVE
#ifdef C6OS_ALPINE_PROC
/* M58：真实 Alpine busybox 的 /proc 端到端验收。
 * cat 走 sendfile→内核中转缓冲→控制台/文件；ps/top 走 /proc/<pid> 目录与
 * 完整 52 字段 stat 行。任何一环退化都会让这里缺标记。 */
static const char kScript[] =
    "echo alpine-proc-alive; "
    "cat /proc/cpuinfo && echo m58-cpuinfo-ok; "
    "cat /proc/meminfo > /data/m58mem.txt && echo m58-meminfo-ok; "
    "stat /proc/1 > /dev/null && echo m58-procdir-ok; "
    "ps; echo m58-ps-ok; "
    "top -b -n 1; echo m58-top-ok; "
    "echo m58-done";
#elif defined(C6OS_ALPINE_NET)
/* 网络端到端：未修改的 Alpine busybox ifconfig + ping。ifconfig 走 /proc/net/dev
 * 与 SIOCGIF*；ping 走 AF_INET/SOCK_RAW/IPPROTO_ICMP（sal_raw.c6）。 */
static const char kScript[] =
    "echo alpine-net-alive; "
    "ifconfig; echo net-iface-ok; "
    "ifconfig eth0; echo net-ifaddr-ok; "
    "ping -c 1 -W 2 127.0.0.1; echo net-ping-loop-ok; "
    "ping -c 1 -W 5 10.0.2.2 && echo net-ping-gw-ok; "
    "nslookup google.com 10.0.2.3 && echo net-dns-ok; "
    "ping -c 1 -W 5 qq.com && echo net-ping-host-ok; "
    "ping -c 1 -W 5 8.8.8.8 && echo net-ping-ext-ok; "
    "echo net-done";
#elif defined(C6OS_ALPINE_WGET)
/* M63：真实 Alpine busybox wget 的 HTTPS 端到端。socketpair + 外部
 * ssl_client + shutdown(SHUT_WR) 三件事任何一件退化，这里都拿不到 OK。 */
static const char kScript[] =
    "echo alpine-wget-alive; "
    "wget -T 20 -O /data/wget.html https://qq.com && echo wget-https-ok; "
    "echo wget-done";
#elif defined(C6OS_ALPINE_CURL)
/* M64：真实 Alpine curl（musl 动态链接 + libcurl + OpenSSL + c-ares）的
 * HTTPS 端到端。和 wget 走的不是同一套代码：libcurl 自己解 URL、自己管
 * CA 路径（/etc/ssl/certs/ca-certificates.crt）、自己 poll 等握手和响应，
 * 任何一环在 Linux ABI 上缺东西都拿不到 curl-https-ok。 */
static const char kScript[] =
    "echo alpine-curl-alive; "
    "curl --version > /dev/null && echo curl-version-ok; "
    "curl -sS -o /data/qq.html https://qq.com && echo curl-https-ok; "
    "test -s /data/qq.html && echo curl-file-ok; "
    /* 把 body 直接打到终端：musl 的 __stdout_write 会先把 len 存进 R10、跨
     * ioctl(TIOCGWINSZ) 之后再用它调 f->write。syscall 返回破坏 R10 时 len
     * 就成了栈地址，writev 整段 EFAULT → curl 报
     * "(23) Failure writing output to destination"，body 一个字节都出不来。
     * 只有这条才走 fwrite → stdout，`-o` 落盘绕开了它（M64 的四个 tag 当初
     * 因此漏掉了这个 bug）。 */
    "curl -sS https://qq.com && echo curl-tty-ok; "
    "echo curl-done";
#elif defined(C6OS_ALPINE_BUSYBOX)
/* 全量 busybox applet 矩阵：脚本在 initramfs 的 /etc/busybox-sweep.sh（由
 * Makefile 的 x86-alpine-busybox 拷进去），A 段把 304 个 applet 各跑两种派发
 * 形式（argv[1] / argv[0]）一次，F 段在 /data 上做功能性验证。脚本只打结果行
 * （XA|applet|rc、XB|applet|rc、OK|name、NO|name|rc），两个总标记由这里打，
 * 这样脚本没跑到底时 check 目标一眼能看出来。 */
static const char kScript[] =
    "echo bx-sweep-alive; "
    "sh /etc/busybox-sweep.sh; "
    "echo bx-sweep-done";
#elif defined(C6OS_ALPINE_APPS)
/* M28：真实 Alpine 程序冒烟——用 ISO 里的 musl 动态链接 busybox applet
 * （cat/tar）在 /data FAT16 上读写，验 VFS 文件句柄回收。
 * 备注：外部命令管道（如 `xx | cat`）与 gzip/sort/grep 在本内核上仍有
 * 兼容限制，作为已知缺口单独记录，不纳入本冒烟脚本。 */
static const char kScript[] =
    "echo alpine-apps-alive; "
    "echo hello > /data/a.txt; "
    "cat /data/a.txt && echo apps-cat-ok; "
    "tar -cf /data/a.tar /data/a.txt && echo apps-tar-ok; "
    "echo apps-done";
#elif defined(C6OS_CHROME)
/* G0-4/G3：Chrome rootfs 从第二块盘/fw_cfg 装载，先验版本，再跑 CDP
 * 显示客户端把一帧写到 /dev/fb0。--frames=1 让客户端拿到第一帧后退出，
 * 验收脚本再用 QEMU screendump 看 VBE 面板。 */
static const char kScript[] =
    "export XDG_RUNTIME_DIR=/tmp; "
    "echo chrome-version-start; "
    "/usr/lib/chromium/chromium --version; "
    "echo chrome-version-done; "
    "echo chrome-dump-start; "
    "/usr/lib/chromium/chromium --headless=new --no-sandbox --disable-gpu "
    "--disable-dev-shm-usage --dump-dom 'data:text/html,<h1>hi</h1>'; "
    "echo chrome-dump-done; "
    "echo chrome-display-start; "
    "/usr/bin/c6chrome-display --chrome=/usr/lib/chromium/chromium "
    "--url='data:text/html,%3Cbody%20style%3D%22background%3A%23ff0000%22%3Ehello%3C/body%3E' "
    "--fb=/dev/fb0 --frames=1; "
    "echo chrome-display-done; "
    "echo chrome-done";
#else
/* 交给 Alpine /bin/sh 的脚本，作为 `sh -c` 的第三个 argv。
 *
 * 用固定脚本而不是裸 `sh`：自动化验收里没法复现"等人输入"，失败时只能看到
 * "什么都没发生"。带 -c 的脚本走的是完全同一条装载 / 动态链接 / 系统调用路径，
 * 但输出确定。想自己敲命令：make run-x86-alpine-shell。
 * 脚本刻意覆盖六件事：往终端写、读内核信息、遍历目录、写 /data 再读回、
 * 挂载点 chdir（cd /data，cd 以前只认 initramfs 扁平表）、df -h 列出 /data。 */
static const char kScript[] =
    "mkdir -p /run/user/0 /dev/shm; "
    "chmod 700 /run/user/0; "
    "export XDG_RUNTIME_DIR=/run/user/0; "
    "echo alpine-M12-alive; "
    "uname -a; "
    "ls /; "
    "echo m12ok > /data/m12.txt; "
    "cat /data/m12.txt; "
    "cd /data && echo cdok > cdok.txt && cat cdok.txt && echo alpine-cd-ok; "
    "df -h; echo alpine-df-done; "
    "echo alpine-M12-done";
#endif

/* argv 表：静态指针数组，加载即有效，不依赖任何构造函数 */
static const char *const kAv[] = { "/bin/sh", "-c", kScript };
#define K_AV_N 3u
#else
/* 交互式（make run-x86-alpine-shell）：裸 /bin/sh，提示符 / #，命令从串口读。
 * 靠的是 lx_proc_poll 真阻塞（见 linux/proc.c）：ash 的 read 内置命令先 poll
 * 再 read，poll 以前空转几千轮就返回 0，ash 当成 stdin EOF 就退出了。 */
static const char *const kAv[] = { "/bin/sh" };
#define K_AV_N 1u
#endif

static void put_u32(UINT32 v)
{
    char b[12] = {0};
    UINT32 i = 0u;
    UINT32 n = 0u;

    if (v == 0u) {
        port_putc((INT32)'0');
        return;
    }
    while (v > 0u && i < 10u) {
        b[i] = (CHAR)('0' + (CHAR)(v % 10u));
        v = v / 10u;
        i++;
    }
    n = i;
    while (n > 0u) {
        n--;
        port_putc((INT32)b[n]);
    }
}

static INT32 blk_rd_cb(UINT32 d, UINT32 blk, UINT32 cnt, VOID *buf)
{
    (void)d;
    return (INT32)port_ata_read(blk, cnt, (u64)buf);
}

static INT32 blk_wr_cb(UINT32 d, UINT32 blk, UINT32 cnt, const VOID *buf)
{
    (void)d;
    return (INT32)port_ata_write(blk, cnt, (u64)buf);
}

#if C6OS_NET
/* qemu -nic user 的默认网络：客户机 10.0.2.15/24，网关 10.0.2.2。
 * 没有网卡时只警告不 abort —— 不带 -nic 跑 check-alpine 仍要能过。 */
#define NET_IP_ME    0x0A00020Fu
#define NET_IP_GW    0x0A000202u
#define NET_IP_MASK  0xFFFFFF00u

static void net_init(void)
{
    LosNetIf *nif = NetIfAttachX86();
    UINT32 i = 0u;

    if (nif == (LosNetIf *)0) {
        port_puts("  net: 没有 e1000（qemu 要 -nic user,model=e1000）\n");
        return;
    }
    if (NetIfSetIp(nif, NET_IP_ME, NET_IP_MASK, NET_IP_GW) != 0 ||
        NetIfUp(nif) != 0) {
        port_puts("  net: 配置 eth0 失败\n");
        return;
    }
    /* 网卡纯轮询：先泵一会儿等链路起来；用户态等待路径另有 lx_net_pump。 */
    while (i < 200000u) {
        (void)NetIfPollX86(nif);
        if (port_net_link_up() == 1) { break; }
        i++;
    }
    /* QEMU -nic user 的网关 MAC 固定为 52:55:0a:00:02:02。纯轮询网卡下
     * 同步 send 拿不到 ARP 应答，先给网关填一条静态表项。 */
    {
        static const UINT8 gw_mac[LOS_ETH_ALEN] = {
            0x52u, 0x55u, 0x0au, 0x00u, 0x02u, 0x02u
        };
        (void)ArpAdd(NET_IP_GW, &gw_mac[0]);
        /* slirp 的 DNS（10.0.2.3）与网关共用同一虚拟 MAC。 */
        (void)ArpAdd(0x0A000203u, &gw_mac[0]);
    }
    (void)SalUdpInit();
    (void)SalTcpInit();
    (void)SalRawInit();
    port_puts("  net: eth0 10.0.2.15/24 gw 10.0.2.2（UDP/TCP/ICMP-raw）\n");
}
#endif

/* 标定出来的 TSC 频率（port/x86_64/irq.c；port_cycles 按它换算成 ns）。 */
extern u64 port_tsc_hz(void);

/* G0-4：Chrome rootfs 太大，不再塞进 ISO（BIOS int15 搬 243MB 要几十分钟），
 * 改走第二块 IDE 盘：LBA0 是 u64 长度前缀，LBA1 起是原始 cpio。这里一次性
 * 分配连续物理页并分块读入，和光盘 rootfs 走同一个 lx_fs_init。 */
static u32 g_rootfs_len;

static u32 rootfs_load_slave(void)
{
    u64 len = 0ull;
    u64 pa = 0ull;
    u64 fsz = 0ull;
    u16 fsel = 0u;
    u32 sec = 0u;
    u32 off = 0u;
    u32 chunk = 0u;
    u32 i = 0u;
    u8 *p = 0;

    /* 调试/验收快路径：QEMU -fw_cfg name=opt/c6rootfs,file=rootfs.img。
     * fw_cfg DMA 由 hypervisor 直接写 guest 物理地址，617MB 几秒完成；
     * 没有该条目时回退到第二块 IDE 盘（生产路径）。 */
    {
        INT32 fwrc = (INT32)port_fwcfg_find("opt/c6rootfs", &fsel, &fsz);
        if (fwrc == 0 && fsz > 512ull && fsz <= 0x60000000ull) {
        pa = port_phys_alloc_pages((fsz + 4095ull) >> 12);
        if (pa == 0ull) {
            port_puts("FAIL: fw_cfg rootfs 连续物理页分配失败\n");
            return 0u;
        }
        {
            INT32 fr = (INT32)port_fwcfg_read(fsel, pa, fsz);
            if (fr != 0) {
                port_puts("FAIL: fw_cfg rootfs DMA 读失败 rc=");
                put_u32((u32)fr);
                port_puts("\n");
                return 0u;
            }
        }
        p = (u8 *)port_phys_map(pa);
        for (i = 0u; i < 8u; i++) {
            len |= ((u64)p[i]) << (u8)(8u * i);
        }
        if (len < 64ull || len > 0x60000000ull) {
            port_puts("FAIL: fw_cfg rootfs 长度前缀不合理\n");
            return 0u;
        }
        g_rootfs_len = (u32)len;
        port_puts("  rootfs: fw_cfg DMA ");
        put_u32((u32)(fsz / 1024u));
        port_puts(" KB（跳过 IDE PIO）\n");
        /* fw_cfg 文件是整块 disk image：LBA0 长度 + LBA1 cpio；调用者
         * 只接受 cpio 起始地址。 */
            return (u32)pa + 512u;
        }
    }

    if (port_ata_read_dev(1u, 0u, 1u, 0x70000u) != 0) {
        port_puts("FAIL: 读第二块盘 rootfs 长度失败\n");
        return 0u;
    }
    p = (u8 *)port_phys_map(0x70000u);
    for (i = 0u; i < 8u; i++) {
        len |= ((u64)p[i]) << (u8)(8u * i);
    }
    if (len < 64ull || len > 0x60000000ull) {         /* <= 1.5GB */
        port_puts("FAIL: 第二块盘 rootfs 长度不合理\n");
        return 0u;
    }
    pa = port_phys_alloc_pages((len + 4095ull) >> 12);
    if (pa == 0ull) {
        port_puts("FAIL: rootfs 连续物理页分配失败\n");
        return 0u;
    }
    sec = (u32)((len + 511ull) / 512ull);
    while (off < sec) {
        chunk = sec - off;
        if (chunk > 200u) {
            chunk = 200u;
        }
        if (port_ata_read_dev(1u, 1u + off, chunk, pa + (u64)off * 512ull) != 0) {
            port_puts("FAIL: 读第二块盘 rootfs 正文失败 off=");
            put_u32(off);
            port_puts(" chunk=");
            put_u32(chunk);
            port_puts(" pa=");
            put_u32((u32)pa);
            port_puts("\n");
            return 0u;
        }
        if (off == 0u) {
            port_puts("  rootfs: 首块正文读入成功\n");
        }
        off += chunk;
    }
    g_rootfs_len = (u32)len;
    port_puts("  rootfs: 第二块 IDE 盘 cpio=");
    put_u32((u32)(len / 1024u));
    port_puts(" KB\n");
    return (u32)pa;
}

void os_main(void)
{
    volatile u32 *bi = (volatile u32 *)(u64)BOOTINFO_PA;
    u64 as = 0u;
    u32 magic = 0u;
    u32 rpa = 0u;
    u32 rlen = 0u;
    u64 fsz = 0u;
    u64 spa = 0u;
    u64 ssz = 0u;
    u64 bpa = 0u;
    u64 bsz = 0u;
    const u8 *base = (const u8 *)0;
    INT32 rc = 0;
    UINT32 i = 0u;

    port_init();
    port_mmu_init();
    port_puts("c6os alpine M12: 从 ISO 起 Alpine（musl 动态链接）\n");
    /* 时间口径一眼可查：port_cycles 已按标定值换算成 ns（失败则退回 1GHz）。 */
    port_puts("  tsc: ");
    put_u32((UINT32)(port_tsc_hz() / 1000000ull));
    port_puts(" MHz（port_cycles 口径 = ns）\n");

    magic = bi[0];
    rpa = bi[5];
    rlen = bi[6];
    if (magic != BOOTINFO_MAGIC) {
        port_puts("FAIL: alpine M12（引导信息块不对）\n");
        return;
    }
    if (rlen == 0u) {
        rpa = rootfs_load_slave();
        if (rpa == 0u) {
            port_puts("FAIL: alpine M12（第二块盘 rootfs 未加载）\n");
            return;
        }
        /* 从磁盘读的 cpio 没有 8 字节前缀；直接从 rpa 解析。 */
        base = (const u8 *)port_phys_map((u64)rpa);
        rlen = 0xFFFFFFFFu;                         /* 由 cpio 自身长度决定，见下 */
    } else {
        port_phys_reserve((u64)rpa, (u64)rlen);
        base = (const u8 *)port_phys_map((u64)rpa);
    }
    if (rlen == 0xFFFFFFFFu) {
        /* 第二块盘：cpio 自身没有外层长度，按 cpio 目录遍历到最后即可；
         * lx_fs_init 只读节点，不会越过 cpio 尾部。长度参数给 0 表示由
         * 解析器自行按目录项推进（见 linux/fs.c 的 cpio 解析循环）。 */
        fsz = 0ull;
        port_puts("  rootfs: pa=");
        put_u32(rpa);
        port_puts("（第二块 IDE 盘，cpio 自描述）\n");
    } else {
        i = 0u;
        while (i < 8u) {
            fsz = fsz | ((u64)base[i] << (u64)(8u * i));
            i++;
        }
        port_puts("  rootfs: pa=");
        put_u32(rpa);
        port_puts(" len=");
        put_u32((u32)fsz);
        port_puts(" cpio=");
        i = 0u;
        while (i < 6u) {
            port_putc((INT32)base[512u + i]);
            i++;
        }
        port_puts("\n");
        if (fsz < 64u || (u64)fsz > (u64)rlen) {
            port_puts("FAIL: alpine M12（rootfs 长度前缀不对）\n");
            return;
        }
    }

    /* 1. rootfs 交给 Linux ABI 的文件系统解析器（ld.so 要按路径从里面找） */
    if (rlen == 0xFFFFFFFFu) {
        if (lx_fs_init((u64)rpa, (u64)g_rootfs_len) != 0) {
            port_puts("FAIL: alpine M12（cpio 解析失败）\n");
            return;
        }
    } else if (lx_fs_init((u64)rpa + 512ull, fsz) != 0) {
        port_puts("FAIL: alpine M12（cpio 解析失败）\n");
        return;
    }
    port_puts("  fs: initramfs 已挂载，节点数=");
    put_u32(lx_fs_nodes());
    port_puts("\n");

    /* 2. 符号链接：/bin/sh -> /bin/busybox，两者查出来的应该是同一份数据 */
    bpa = lx_fs_pa_of("/bin/busybox");
    bsz = lx_fs_size_of("/bin/busybox");
    spa = lx_fs_pa_of("/bin/sh");
    ssz = lx_fs_size_of("/bin/sh");
    port_puts("  /bin/busybox pa=");
    put_u32((u32)bpa);
    port_puts(" size=");
    put_u32((u32)bsz);
    port_puts("\n");
    port_puts("  /bin/sh      pa=");
    put_u32((u32)spa);
    port_puts(" size=");
    put_u32((u32)ssz);
    port_puts("（符号链接）\n");
    if (bsz < 64u || bpa == 0u) {
        port_puts("FAIL: alpine M12（镜像里没有 /bin/busybox）\n");
        return;
    }
    if (spa != bpa || ssz != bsz) {
        port_puts("FAIL: alpine M12（/bin/sh 的符号链接没解析到 /bin/busybox）\n");
        return;
    }
    if (lx_fs_size_of("/lib/ld-musl-x86_64.so.1") < 64u) {
        port_puts("FAIL: alpine M12（镜像里没有 musl 的 ld.so）\n");
        return;
    }

    /* 3. 可写数据盘 → /data（容器里能落盘）
     * Chrome rootfs 测试不接 FAT 数据盘（IDE 主盘位留给 rootfs），跳过。 */
#ifdef C6OS_CHROME
    port_puts("  /data: 本目标未接数据盘（跳过）\n");
#else
    rc = (INT32)LOS_DeviceRegister("ata0", 512u, 32768u, blk_rd_cb, blk_wr_cb);
    if (rc < 0) {
        port_puts("FAIL: alpine M12（注册 ata0）\n");
        return;
    }
    g_part.lba = FAT_LBA;
    rc = (INT32)LOS_FsMount("ata0", "/data", "fatfs", &g_part);
    if (rc != 0) {
        port_puts("FAIL: alpine M12（/data 挂载 rc=");
        put_u32((u32)(0 - rc));
        port_puts("）\n");
        return;
    }
    port_puts("  /data = FAT16 数据盘（可写）\n");
#endif

    /* 4. 串口接上行规程：0 号 fd 变真终端，sh 才会认自己交互式 */
    lx_tty_init();
    port_puts("  tty: 串口行规程已开（0/1/2 是终端）\n");

#if C6OS_NET
    /* 4.5 网络和 SAL：ifconfig/socket/ping 的 syscall 都依赖这一步 */
    net_init();
#endif

    /* 5. 进用户态跑 /bin/sh（动态 PIE：先跑 ld-musl，再把控制权交给 busybox）
     *
     * 用 `sh -c '脚本'` 而不是裸 `sh`：裸 sh 要等串口输入，自动化验收里没法
     * 复现——失败时只能看到"什么都没发生"。带 -c 的固定脚本走的是完全同一条
     * 装载 / 动态链接 / 系统调用路径，但输出确定。
     * 脚本刻意覆盖四件事：往终端写、读内核信息、遍历目录、写 /data 再读回。 */
    port_linux_arch_init();
    as = port_as_create();
    if (as == 0u) {
        port_puts("FAIL: alpine M12（port_as_create）\n");
        return;
    }
    if (lx_exec_preparev(as, spa, ssz, "/bin/sh", kAv, K_AV_N) != 0) {
        port_puts("FAIL: alpine M12（lx_exec_preparev）\n");
        return;
    }
    port_puts("  elf 就绪，进用户态（Alpine 的 /bin/sh -c）\n");
    port_user_enter(as, lx_exec_entry(), lx_exec_rsp(), 0u);
    port_puts("FAIL: alpine M12（从用户态返回，不应发生）\n");
}
