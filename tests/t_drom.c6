/* 判别：DROM 窗口(0x3C000000)能否读？我们的 .flash.rodata 在 0x3C000020，
 * 内容是 app_desc 魔数 0xABCD5432 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
void os_main(void)
{
    s3_beacon(0u, 0xB00000C0u);
    s3_beacon(1u, *(volatile u32 *)0x3C000020u);   /* 期望 0xABCD5432 */
    s3_beacon(2u, os_reg_rd(0x600C5000u));         /* MMU[0] 应该 = 2 */
    s3_beacon(3u, *(volatile u32 *)0x42030000u);   /* IROM 对照 */
    for (;;) { }
}
