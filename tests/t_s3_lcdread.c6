/* t_s3_lcdread.c6 —— 给面板装一条"客观读回"通道。
 *
 * 之前 RDDID 读不出值，根因是 SPI 时钟根本没出脚（§4.6）；现在时钟通了，
 * 只要把 SDA 那根 pad 的输出放开、把 FSPIQ 输入矩阵接到它，就能真的读回：
 *   RDDID(0x04) → 期望 0x00 0x85 0x85 0x52 之类
 *   RAMRD(0x2E) → 读回 GRAM 里的像素（这才是验证"DMA 到底画对没画对"的关键）
 *
 * 先画一块已知图案（CPU 通路），再读回比对，就能判断读通道本身可不可信。
 */
#include "c6os/types.h"
#include "c6os/port.h"

#define SPI3_BASE 0x60025000u
#define PIN_DC    8u
#define PIN_SDA   10u

#define SPI_CMD    (*(volatile u32 *)(SPI3_BASE + 0x00u))
#define SPI_USER   (*(volatile u32 *)(SPI3_BASE + 0x10u))
#define SPI_DLEN   (*(volatile u32 *)(SPI3_BASE + 0x1Cu))
#define SPI_W(n)   (*(volatile u32 *)(SPI3_BASE + 0x98u + 4u * (n)))
#define SPI_MUX(p) (*(volatile u32 *)(0x60009000u + 0x04u + 4u * (p)))
#define SPI_INSEL(sig) (*(volatile u32 *)(0x60004000u + 0x154u + 4u * (sig)))
#define SPI_OUTSEL(p)  (*(volatile u32 *)(0x60004000u + 0x554u + 4u * (p)))
#define SPI_ENA_W1TC   (*(volatile u32 *)(0x60004000u + 0x28u))
#define SPI_ENA_W1TS   (*(volatile u32 *)(0x60004000u + 0x24u))
#define GPIO_OUT_SEL_GPIO 128u

void s3_lcd_init(void);
void s3_lcd_bl(u32 on);
void s3_lcd_delay(u32 n);
void s3_lcd_cmd(u32 c);
void s3_lcd_dat(u32 v);
void s3_lcd_fill_rect(u32 x, u32 y, u32 w, u32 h, u16 color);
void s3_pin_set(u32 pin, u32 v);

static void puts_(const char *s) { while (*s != '\0') { port_putc(*s); s++; } }

static void phex2(u32 v)
{
    static const char h[] = "0123456789abcdef";
    port_putc((int)h[(v >> 4) & 0xFu]);
    port_putc((int)h[v & 0xFu]);
}

/* 读 n 字节（n ≤ 16）：DC=1，SDA 由面板驱动（放开 pad 输出），FSPIQ 输入 */
static u32 lcd_read(u8 *out, u32 n)
{
    u32 i = 0;
    u32 guard = 0;

    /* 输入通路：pad10 输入使能 + FSPIQ(102) 选到 pad10 */
    SPI_MUX(PIN_SDA) = SPI_MUX(PIN_SDA) | (1u << 9);
    SPI_INSEL(102u) = (PIN_SDA & 0x3Fu) | (1u << 6);
    /* 放开 SDA 输出，别和面板抢总线 */
    SPI_OUTSEL(PIN_SDA) = GPIO_OUT_SEL_GPIO;
    SPI_ENA_W1TC = (1u << PIN_SDA);

    SPI_USER = (1u << 27) | (1u << 28) | 1u;      /* MOSI|MISO|DOUTDIN */
    i = 0;
    while (i < 16u) { SPI_W(i) = 0xFFFFFFFFu; i++; }
    SPI_DLEN = n * 8u - 1u;
    SPI_CMD = (1u << 23);
    guard = 0;
    while ((SPI_CMD & (1u << 23)) != 0u) { guard++; if (guard > 2000000u) { return 1u; } }
    SPI_CMD = (1u << 24);
    guard = 0;
    while ((SPI_CMD & (1u << 24)) != 0u) { guard++; if (guard > 2000000u) { return 2u; } }

    i = 0;
    while (i < n) {
        u32 w = SPI_W(i / 4u);
        out[i] = (u8)(w >> (8u * (i % 4u)));
        i++;
    }
    SPI_USER = (1u << 27);
    SPI_ENA_W1TS = (1u << PIN_SDA);          /* 交回给 SPI 的 MOSI */
    return 0u;
}

static void show(const char *tag, u32 rc, const u8 *b, u32 n)
{
    u32 i = 0;

    puts_(tag);
    puts_(" rc=");
    phex2(rc);
    puts_(" ");
    while (i < n) { phex2((u32)b[i]); i++; }
    puts_("\n");
}

void os_main(void)
{
    u8 b[8] = {0};

    s3_lcd_init();
    s3_lcd_bl(1u);
    s3_lcd_delay(4000000u);

    /* 先画一块纯红（CPU 通路），供 RAMRD 比对 */
    s3_lcd_fill_rect(0u, 0u, 4u, 4u, 0xF800u);
    s3_lcd_delay(4000000u);

    /* RDDID：命令 0x04，然后读 4 字节 */
    s3_lcd_cmd(0x04u);
    s3_lcd_delay(200000u);
    s3_pin_set(PIN_DC, 1u);
    show("rddid ", lcd_read(b, 4u), b, 4u);

    /* RDDST：0x09，读 4 字节 */
    s3_pin_set(PIN_DC, 0u);
    s3_lcd_delay(200000u);
    s3_lcd_cmd(0x09u);
    s3_lcd_delay(200000u);
    s3_pin_set(PIN_DC, 1u);
    show("rddst ", lcd_read(b, 4u), b, 4u);

    /* RAMRD：设窗口 (0,0)-(1,1)，命令 0x2E，读 4 字节（红 0xF8 0x00…） */
    s3_pin_set(PIN_DC, 0u);
    s3_lcd_cmd(0x2Au);
    s3_lcd_dat(0u); s3_lcd_dat(0u); s3_lcd_dat(1u); s3_lcd_dat(1u);
    s3_lcd_cmd(0x2Bu);
    s3_lcd_dat(0u); s3_lcd_dat(0u); s3_lcd_dat(1u); s3_lcd_dat(1u);
    s3_lcd_cmd(0x2Eu);
    s3_lcd_delay(200000u);
    s3_pin_set(PIN_DC, 1u);
    show("ramrd ", lcd_read(b, 8u), b, 8u);

    for (;;) { s3_lcd_delay(4000000u); }
}
