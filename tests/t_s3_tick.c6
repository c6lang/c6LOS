#include "c6os/types.h"
#include "c6os/tick.h"
#include "c6os/port.h"

void s3_mark(u32 idx, u32 v);

void put_u32(u32 v) {
    char buf[12] = {0};
    u32 n = 0;

    if (v == 0u) {
        port_putc((int)48);
        return;
    }
    while (v > 0u && n < 12u) {
        buf[n] = (char)(48 + (v % 10u));
        v = v / 10u;
        n++;
    }
    while (n > 0u) {
        n--;
        port_putc((int)buf[n]);
    }
}

void os_main(void) {
    u32 t0 = 0;
    u32 i = 0;
    u32 elapsed = 0;

    port_puts("s3 tick test\n");
    t0 = (u32)os_tick_get();
    while (((u32)os_tick_get() - t0) < 100u) {
        port_idle();
        i++;
        if ((i & 0xFFFFu) == 0u) {
            s3_mark(5u, i);
        }
    }
    elapsed = (u32)os_tick_get() - t0;
    port_puts("DONE elapsed=");
    put_u32(elapsed);
    port_putc(10);
    if (elapsed >= 99u && elapsed <= 101u) {
        port_puts("PASS: tick\n");
    } else {
        port_puts("FAIL: tick\n");
    }
}
