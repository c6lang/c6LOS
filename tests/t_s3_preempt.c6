#include "c6os/types.h"
#include "c6os/task.h"
#include "c6os/tick.h"
#include "c6os/port.h"

static u32 ca = 0;
static u32 cb = 0;
static u32 g_end = 0;

static void put_u32(u32 v) {
    char b[12] = {0};
    int i = 0;

    if (v == 0u) {
        port_putc('0');
        return;
    }
    while (v > 0u) {
        b[i] = (char)('0' + (v % 10u));
        i++;
        v = v / 10u;
    }
    while (i > 0) {
        i--;
        port_putc((int)b[i]);
    }
}

static void ta(void *arg) {
    while ((u32)os_tick_get() < g_end) {
        ca++;
    }
}

static void tb(void *arg) {
    while ((u32)os_tick_get() < g_end) {
        cb++;
    }
}

void os_main(void) {
    port_init();
    port_puts("c6os s3 preempt test\n");
    g_end = (u32)os_tick_get() + 20u;
    if (os_task_create("a", ta, 0, 1u, 4096u) <= 0 ||
        os_task_create("b", tb, 0, 1u, 4096u) <= 0) {
        port_puts("FAIL: create\n");
        return;
    }
    os_task_start();
    port_puts("ca=");
    put_u32(ca);
    port_puts(" cb=");
    put_u32(cb);
    port_puts("\n");
    if (ca > 0u && cb > 0u) {
        port_puts("PASS: s3 preempt\n");
    } else {
        port_puts("FAIL: s3 preempt\n");
    }
}
