/* t_s3_irom18.c6 —— 正确值 + 正确顺序：
 * 关双 cache -> 写 IDF 实测值(SPI_MEM_CTRL=0, CLOCK=0x00010001) -> 开双 cache -> 数据读
 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

void s3_win_call_log(const char *s);
u32  s3_win_call_flash42(void);
static void pstr(const char *s) { s3_win_call_log(s); }
static void phex(u32 v)
{
    char b[11] = {0}; int i = 2; int sh = 28; const char *h = "0123456789abcdef";
    b[0] = '0'; b[1] = 'x';
    while (sh >= 0) { b[i] = h[(v >> (u32)sh) & 0xFu]; i++; sh -= 4; }
    b[10] = '\0'; pstr(b); pstr("\n");
}

void os_main(void)
{
    u32 v = 0u;

    s3_beacon(0u, 0xB0000019u);

    os_reg_wr(0x600C4060u, 0x0u);          /* ICACHE off */
    os_reg_wr(0x600C4000u, 0x0u);          /* DCACHE off */

    /* 注意：写 SPI_MEM_CTRL=0 会让控制器不可访问，故不动它 */
    os_reg_wr(0x60002014u, 0x00010001u);   /* SPI_MEM_CLOCK = IDF 实测值 */

    os_reg_wr(0x600C4000u, 0x00000009u);   /* DCACHE: ENABLE|BLOCKSIZE (IDF 值) */
    os_reg_wr(0x600C4060u, 0x0000000Bu);   /* ICACHE: ENABLE|WAY|BLOCKSIZE (IDF 值) */

    s3_beacon(3u, os_reg_rd(0x60002008u));
    pstr("spictrl="); phex(os_reg_rd(0x60002008u));
    pstr("spiclk=");  phex(os_reg_rd(0x60002014u));
    pstr("icache=");  phex(os_reg_rd(0x600C4060u));

    v = *(volatile u32 *)0x42030000u;      /* 期望 0x7b004136 */
    s3_beacon(2u, v);
    pstr("irom3="); phex(v);

    v = s3_win_call_flash42();
    s3_beacon(1u, 0xF1000000u | (v & 0xFFu));
    pstr("call="); phex(v);
    for (;;) { }
}
