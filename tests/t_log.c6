#include "c6os/log.h"

void port_sim_capture_begin(void);
const char *port_sim_capture_end(void);

static int streq(const char *a, const char *b) {
    while (*a != '\0' && *b != '\0') {
        if (*a != *b) {
            return 0;
        }
        a++;
        b++;
    }
    return *a == *b;
}

int main(void) {
    port_sim_capture_begin();
    kprintf("d=%d u=%u x=%x X=%X s=%s c=%c\n", -5, 42u, 0xbeefu, 0xbeefu, "hi", 'Z');
    kprintf("w=%05d z=%08x p=%p\n", 42, 0xabcdu, (void *)0x1234);
    const char *got = port_sim_capture_end();
    const char *want = "d=-5 u=42 x=beef X=BEEF s=hi c=Z\nw=00042 z=0000abcd p=0x1234\n";

    if (!streq(got, want)) {
        kputs("FAIL: kprintf\n");
        kputs("got:  ");
        kputs(got);
        kputs("want: ");
        kputs(want);
        return 1;
    }
    kputs("PASS: kprintf\n");
    return 0;
}
