#include "c6os/types.h"
#include "c6os/port.h"

extern int s3_core1_start(void);
extern u32 s3_core1_count(void);
extern u32 s3_core1_prid(void);

static void put_u32(u32 v) {
    char b[12] = {0};
    int i = 0;

    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v /= 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

void os_main(void) {
    u32 i = 0;

    port_init();
    port_puts("c6os core1 test\n");
    s3_core1_start();
    while (i < 2000000u) { i++; }
    port_puts("core1 count=");
    put_u32(s3_core1_count());
    port_puts(" prid=");
    put_u32(s3_core1_prid());
    port_puts("\n");
    if (s3_core1_count() != 0u && s3_core1_prid() == 1u) {
        port_puts("PASS: core1\n");
    } else {
        port_puts("FAIL: core1\n");
    }
}
