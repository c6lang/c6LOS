/* t_s3_irom16.c6 —— 用**自己的代码**读寄存器并打印，与 IDF 参照 app 的 PROBE 输出对比。 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

void s3_win_call_log(const char *s);
static void pstr(const char *s) { s3_win_call_log(s); }
static void phex(u32 v)
{
    char b[11] = {0}; int i = 2; int sh = 28; const char *h = "0123456789abcdef";
    b[0] = '0'; b[1] = 'x';
    while (sh >= 0) { b[i] = h[(v >> (u32)sh) & 0xFu]; i++; sh -= 4; }
    b[10] = '\0'; pstr(b);
}
static void kv(const char *k, u32 v) { pstr(k); phex(v); pstr("\n"); }

void os_main(void)
{
    u32 v = 0u;

    s3_beacon(0u, 0xB0000016u);

    kv("mmu0=", os_reg_rd(0x600C5000u));
    kv("mmu1=", os_reg_rd(0x600C5004u));
    kv("mmu2=", os_reg_rd(0x600C5008u));
    kv("icache=", os_reg_rd(0x600C4060u));
    kv("dcache=", os_reg_rd(0x600C4000u));
    kv("spiclk=", os_reg_rd(0x60002014u));
    kv("spictrl=", os_reg_rd(0x60002008u));

    /* 按 IDF 参照 app 的实测值配置 cache 模式和 SPI 控制器 */
    os_reg_wr(0x600C4000u, 0x00000009u);   /* DCACHE: ENABLE|BLOCKSIZE */
    os_reg_wr(0x600C4060u, 0x0000000Bu);   /* ICACHE: ENABLE|WAY_MODE|BLOCKSIZE */
    os_reg_wr(0x60002014u, 0x00010001u);   /* SPI_MEM_CLOCK */
    os_reg_wr(0x60002008u, 0x00000000u);   /* SPI_MEM_CTRL  */

    kv("icache_now=", os_reg_rd(0x600C4060u));
    kv("spiclk_now=", os_reg_rd(0x60002014u));

    v = *(volatile u32 *)0x42030000u;      /* 我们的 IROM 页3 */
    kv("irom3=", v);
    s3_beacon(1u, v);
    for (;;) { }
}
