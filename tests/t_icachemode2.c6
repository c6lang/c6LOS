/* 确认取指也能通：配好 I-cache 后调用 flash 里的 movi.n a2,42; retw.n */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
u32 s3_win_call_config_icache_mode(u32 size, u32 ways, u32 line);
u32 s3_win_call_cache_invalidate_addr(u32 addr, u32 size);
u32 s3_win_call_flash42(void);
void os_main(void)
{
    u32 v = 0u;
    s3_beacon(0u, 0xB00000E0u);

    s3_win_call_config_icache_mode(32768u, 8u, 32u);
    s3_win_call_cache_invalidate_addr(0x42030000u, 0x10000u);

    s3_beacon(2u, *(volatile u32 *)0x42030000u);   /* 数据读 */
    v = s3_win_call_flash42();                     /* 取指并执行 */
    s3_beacon(1u, 0xF1000000u | (v & 0xFFu));      /* 期望 0xF100002A (42) */
    s3_beacon(3u, v);
    for (;;) { }
}
