/* t_s3_adc.c6 —— 扫描 ADC1 通道 0..9（对应 GPIO1..GPIO10），把原始值显示在屏上。
 * 目的是找出"音量键"是否接成电阻分压（ADC 键盘）：按键时某个通道值会明显变化。
 *
 * 用 S3 的 APB_SARADC oneshot：
 *   CTRL(0x00): XPD_SAR_FORCE[28:27]=3 | SAR1_PATT_LEN[18:15]=0 | SAR_CLK_DIV[14:7]
 *   PATT_TAB1(0x18): 通道号（每 4bit 一个）
 *   CTRL2(0x04): MEAS_NUM_LIMIT=1 | MAX_MEAS_NUM=1
 *   CTRL.START_FORCE(bit0) + START(bit1) 启动，轮询 INT_RAW 的 SARADC1_DONE
 *   APB_SARADC1_DATA_STATUS(0x40): 数据[16:0]
 *   SENS_SAR_ATTEN1(0x60008814): 每通道 2bit，3=11dB（0~3.1V）
 */

#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/gfx.h"

#define W 240u
#define H 240u
#define ADC_BASE   0x60040000u
#define SENS_BASE  0x60008800u
#define SYS_CLK_EN0 (*(volatile u32 *)0x600C0018u)
#define SYS_RST_EN0 (*(volatile u32 *)0x600C0020u)

#define ADC_CTRL    (*(volatile u32 *)(ADC_BASE + 0x00u))
#define ADC_CTRL2   (*(volatile u32 *)(ADC_BASE + 0x04u))
#define ADC_PATT1   (*(volatile u32 *)(ADC_BASE + 0x18u))
#define ADC_DATA    (*(volatile u32 *)(ADC_BASE + 0x40u))
#define ADC_INT_RAW (*(volatile u32 *)(ADC_BASE + 0x60u))
#define ADC_INT_CLR (*(volatile u32 *)(ADC_BASE + 0x68u))
#define ADC_CLKM    (*(volatile u32 *)(ADC_BASE + 0x70u))
#define SENS_ATTEN1 (*(volatile u32 *)(SENS_BASE + 0x14u))

void s3_lcd_init(void);
void s3_lcd_blit(const u16 *fb, u32 w, u32 h);
void s3_lcd_delay(u32 n);
void s3_lcd_bl(u32 on);

static u16 g_fb[W * H] = {0};
static OsGfx g;
static u32 g_val[10];
static u32 g_min[10];
static u32 g_max[10];

static void pstr(const char *s)
{
    while (*s != '\0') { port_putc(*s); s++; }
}

static void pu32(u32 v)
{
    char b[12] = {0};
    int i = 0;
    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v = v / 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

static void u2s(char *out, u32 v)
{
    char tmp[12] = {0};
    int n = 0;
    int i = 0;

    if (v == 0u) { out[0] = '0'; out[1] = '\0'; return; }
    while (v > 0u) { tmp[n] = (char)('0' + (v % 10u)); n++; v = v / 10u; }
    while (n > 0) { n--; out[i] = tmp[n]; i++; }
    out[i] = '\0';
}

static void adc_init(void)
{
    SYS_CLK_EN0 = SYS_CLK_EN0 | (1u << 28);        /* APB_SARADC 时钟 */
    SYS_RST_EN0 = SYS_RST_EN0 & ~(1u << 28);

    ADC_CLKM = (1u << 20) | (0u << 21) | 4u;       /* CLK_EN，源=APB，div=4 */
    SENS_ATTEN1 = 0xFFFFFFFFu;                     /* 所有通道 11dB */
    ADC_CTRL = (3u << 27)                          /* XPD_SAR_FORCE=3 上电 */
             | (0u << 15)                          /* SAR1_PATT_LEN=0 → 1 个通道 */
             | (20u << 7);                         /* SAR_CLK_DIV */
    ADC_CTRL2 = (1u << 0) | (1u << 1);             /* 只测一次 */
}

static u32 adc_read(u32 ch)
{
    u32 guard = 0;

    ADC_PATT1 = (ch & 0xFu);                       /* 第一个 nibble = 通道号 */
    ADC_INT_CLR = 0xFFFFFFFFu;
    ADC_CTRL = ADC_CTRL | (1u << 0);               /* START_FORCE */
    ADC_CTRL = ADC_CTRL | (1u << 1);               /* START */
    ADC_CTRL = ADC_CTRL & ~(1u << 1);

    while (guard < 200000u) {
        if ((ADC_INT_RAW & 1u) != 0u) { break; }
        guard++;
    }
    return ADC_DATA & 0xFFFu;
}

static void draw(void)
{
    u32 i = 0;

    os_gfx_fill_rect(&g, 0, 0, (int)W, (int)H, 0x0000u);
    os_gfx_text16(&g, 4, 2, "ADC1 SCAN (GPIO1-10)", 0x07FFu);

    while (i < 10u) {
        int col = (int)(i % 2u);
        int rowi = (int)(i / 2u);
        int x = 4 + col * 118;
        int y = 22 + rowi * 34;
        char s[12] = {0};

        os_gfx_text16(&g, x, y, "ch", 0xFFE0u);
        u2s(s, i);
        os_gfx_text16(&g, x + 24, y, s, 0xFFE0u);

        u2s(s, g_val[i]);
        os_gfx_text16(&g, x + 4, y + 16, s, 0xFFFFu);
        i++;
    }
    s3_lcd_blit(g_fb, W, H);
}

void os_main(void)
{
    u32 i = 0;
    u32 round = 0;

    pstr("c6os adc scan\n");
    adc_init();
    s3_lcd_init();
    s3_lcd_bl(1u);
    os_gfx_init(&g, g_fb, W, H);

    i = 0;
    while (i < 10u) {
        g_val[i] = 0u;
        g_min[i] = 0xFFFFFFFFu;
        g_max[i] = 0u;
        i++;
    }

    for (;;) {
        i = 0;
        while (i < 10u) {
            u32 v = adc_read(i);
            g_val[i] = v;
            if (v < g_min[i]) { g_min[i] = v; }
            if (v > g_max[i]) { g_max[i] = v; }
            i++;
        }
        draw();

        if ((round % 8u) == 0u) {
            pstr("adc:");
            i = 0;
            while (i < 10u) {
                pstr(" ");
                pu32(g_val[i]);
                i++;
            }
            pstr("\n");
        }
        round++;
        s3_lcd_delay(400000u);      /* 约 10ms */
    }
}
