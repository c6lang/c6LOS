/* tests/t_pbkdf2.c6 —— WPA2-PSK 的 "口令 → PSK" 算法自测（宿主，无需板子）
 *
 * 为什么单独测它（docs/wifi-plan.md §218）：闭源 WiFi 库关联 WPA2 AP 时，会回调
 * 我们提供的 `pbkdf2_sha1`（wpa_crypto 表里的一项）把口令派生成 PSK。这里的
 * 参考值是 IEEE 802.11i 的公开测试向量：
 *      passphrase = "password", ssid = "IEEE", iterations = 4096
 *      PSK = f42c6fc52df0ebef9ebb4b90b38a5f902e83fe1b135a70e23aed762e9710a12e
 * 板子上跑的是 port/s3/wpa_crypto.c 里的 C 版（同一套 hmac_sha1 原语）。
 *
 * 跑法（或 make tls12check 里会跑）：
 *   /home/winger/c6/tcc/c6 -B /home/winger/c6/tcc -I/home/winger/c6 -o build/hostc6/pbkdf2_test \
 *       /home/winger/c6/std/core/types.c6 /home/winger/c6/std/encoding/sha1.c6 \
 *       tests/t_pbkdf2.c6
 */
#include <stdio.h>
#include <string.h>

import std.core.types;
import std.encoding.sha1;

static int fails = 0;

static int hexval(int c)
{
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return -1;
}

static int unhex(const char *s, u8 *out, int cap)
{
    int n = 0;

    while (s[0] != 0 && s[1] != 0 && n < cap) {
        int hi = hexval((int)s[0]);
        int lo = hexval((int)s[1]);

        if (hi < 0 || lo < 0) { return -1; }
        out[n] = (u8)((hi << 4) | lo);
        n = n + 1;
        s = s + 2;
    }
    return n;
}

static int same(const u8 *a, const u8 *b, int n)
{
    int i = 0;

    for (i = 0; i < n; i++) {
        if (a[i] != b[i]) { return 0; }
    }
    return 1;
}

/* 与 port/s3/wpa_crypto.c 里 c6_pbkdf2_sha1 完全同构 */
static int pbkdf2(const char *pass, const char *ssid, int slen, int iters, u8 *out, int outlen)
{
    u8 u[32] = { 0 };
    u8 t[32] = { 0 };
    u8 msg[80] = { 0 };
    int klen = (int)strlen(pass);
    int off = 0;
    u32 block = 1;
    int it = 0;
    int i = 0;

    while (off < outlen) {
        memcpy(msg, ssid, (usize)slen);
        msg[slen] = (u8)((block >> 24) & 0xff);
        msg[slen + 1] = (u8)((block >> 16) & 0xff);
        msg[slen + 2] = (u8)((block >> 8) & 0xff);
        msg[slen + 3] = (u8)(block & 0xff);
        hmac_sha1(pass, klen, msg, slen + 4, u);
        memcpy(t, u, 20);
        for (it = 1; it < iters; it++) {
            hmac_sha1(pass, klen, u, 20, u);
            for (i = 0; i < 20; i++) {
                t[i] = (u8)(t[i] ^ u[i]);
            }
        }
        for (i = 0; i < 20 && off < outlen; i++) {
            out[off] = t[i];
            off = off + 1;
        }
        block = block + 1;
    }
    return 0;
}

int main(void)
{
    u8 psk[32] = { 0 };
    u8 want[32] = { 0 };

    (void)unhex("f42c6fc52df0ebef9ebb4b90b38a5f902e83fe1b135a70e23aed762e9710a12e", want, 32);
    printf("== PBKDF2-HMAC-SHA1（IEEE 802.11i：password + IEEE，4096 轮）\n");
    (void)pbkdf2("password", "IEEE", 4, 4096, psk, 32);
    if (same(psk, want, 32)) {
        printf("   ok   PSK 与 IEEE 测试向量一致\n");
    } else {
        printf("   FAIL PSK 不一致：%02x%02x%02x%02x...（应为 f42c6fc5...）\n",
               (int)psk[0], (int)psk[1], (int)psk[2], (int)psk[3]);
        fails = fails + 1;
    }
    printf("%s（失败 %d 项）\n", fails == 0 ? "PBKDF2 自测通过" : "自测失败", fails);
    return fails == 0 ? 0 : 1;
}
