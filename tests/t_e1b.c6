/* E1b: 用 DBUS 访问/缺失计数器（我们的 IROM 读是 load，走 DBUS） */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
void os_main(void)
{
    u32 d0 = 0u, m0 = 0u;
    s3_beacon(0u, 0xB0000081u);

    os_reg_wr(0x600C40C4u, 0x3u);
    d0 = os_reg_rd(0x600C40D8u);           /* DBUS_ACS_CNT */
    m0 = os_reg_rd(0x600C40D0u);           /* DBUS_FLASH_MISS */

    (void)*(volatile u32 *)0x42030000u;
    (void)*(volatile u32 *)0x42030004u;

    s3_beacon(1u, os_reg_rd(0x600C40D8u) - d0);   /* DBUS 访问增量 */
    s3_beacon(2u, os_reg_rd(0x600C40D0u) - m0);   /* DBUS flash 缺失增量 */
    s3_beacon(3u, os_reg_rd(0x600C4154u));        /* ICACHE_FREEZE */
    for (;;) { }
}
