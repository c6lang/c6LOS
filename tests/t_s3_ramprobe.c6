/* t_s3_ramprobe.c6 —— 分块逐字清零整段 DRAM，打印每一块，看停在哪。
 * 停了就说明"密集写某一小段"会把 CPU 挂住（稀疏写没问题），据此定位。
 */
#include "c6os/types.h"
#include "c6os/port.h"

#define LO 0x3FCD8000u
#define HI 0x3FCDD000u
#define STEP 0x100u          /* 256B 一块 */

void s3_lcd_delay(u32 n);

static void pstr(const char *s) { while (*s != '\0') { port_putc(*s); s++; } }

static void hex32(u32 v)
{
    int i = 28;
    u32 nib = 0u;

    while (i >= 0) {
        nib = (v >> (u32)i) & 0xFu;
        port_putc((int)(nib < 10u ? ('0' + nib) : ('a' + nib - 10u)));
        i -= 4;
    }
}

static void pu32(u32 v)
{
    char b[12] = {0};
    int i = 0;

    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v = v / 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

void os_main(void)
{
    u32 blk = LO;
    u32 a = 0u;
    u32 v = 0u;
    u32 bad = 0u;
    u32 n = 0u;

    pstr("c6os chunk clear probe\n");

    while (blk < HI) {
        u32 end = blk + STEP;

        if (end > HI) { end = HI; }
        pstr("blk ");
        hex32(blk);
        pstr(" .. ");
        hex32(end);
        pstr(" ");
        a = blk;
        while (a < end) {
            *(volatile u32 *)a = 0u;
            a = a + 4u;
        }
        /* 立刻回读校验 */
        a = blk;
        bad = 0u;
        while (a < end) {
            if (*(volatile u32 *)a != 0u) { bad = bad + 1u; }
            a = a + 4u;
        }
        pstr("bad=");
        pu32(bad);
        pstr("\n");
        blk = end;
        n++;
    }

    pstr("all blocks cleared, count=");
    pu32(n);
    pstr("\n");

    /* 再整段写图案 + 回读 */
    a = LO;
    while (a < HI) {
        *(volatile u32 *)a = 0xA5C30000u | (a & 0xFFFFu);
        a = a + 4u;
    }
    a = LO;
    while (a < HI) {
        v = *(volatile u32 *)a;
        if (v != (0xA5C30000u | (a & 0xFFFFu))) { bad = bad + 1u; }
        a = a + 4u;
    }
    pstr("pattern mismatches=");
    pu32(bad);
    pstr("\nprobe done\n");

    for (;;) {
        s3_lcd_delay(4000000u);
        pstr("alive\n");
    }
}
