/* 调用放在 .flash.text 末尾的 call0 函数（期望返回 x+9） */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
#include "c6os/flash.h"
u32 s3_flash_end_test(u32 x);
void os_main(void)
{
    u32 v = 0u;
    s3_beacon(0u, 0xB0000150u);
    os_icache_enable();
    v = s3_flash_end_test(33u);       /* 期望 42 */
    s3_beacon(1u, v);
    for (;;) { }
}
