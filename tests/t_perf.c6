/* 微基准：yield 上下文切换、sem、queue、heap、tick。
 * host 用 rdtsc（cycles），risc6 bare 用 rdcycle（指令数*64）。 */
#include "c6os/task.h"
#include "c6os/sem.h"
#include "c6os/queue.h"
#include "c6os/heap.h"
#include "c6os/tick.h"
#include "c6os/port.h"

#if defined(C6OS_BARE) || defined(C6OS_S3)
#define PERF_N 1000u
#else
#define PERF_N 100000u
#endif

static volatile u32 g_sink;
static void *g_qstore[8] = {0};
static u32 g_yield = 0;
static u32 g_sem = 0;
static u32 g_queue = 0;
static u32 g_heap = 0;
static u32 g_tick = 0;

static void out_u32(u32 v) {
    char b[12] = {0};
    int i = 0;

    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u && i < 12) { b[i] = (char)('0' + (v % 10u)); i++; v /= 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

static void report(const char *name, u32 cyc, u32 n) {
    port_puts(name);
    port_puts(": total=");
    out_u32(cyc);
    port_puts(" per_op=");
    out_u32(n != 0u ? (cyc / n) : 0u);
    port_puts("\n");
}

static void bench(void *arg) {
    u32 i = 0;
    u32 t0 = 0;
    u32 t1 = 0;
    OsSem s = {0};
    OsQueue q = {0};
    OsHeap h = {0};
    u8 arena[1024] = {0};
    u32 v = 0x12345678u;
    void *p = 0;

    (void)arg;

    t0 = (u32)port_cycles();
    i = 0;
    while (i < PERF_N) {
        os_task_yield();
        i++;
    }
    t1 = (u32)port_cycles();
    g_yield = t1 - t0;

    (void)os_sem_init(&s, 0u, 1u);
    t0 = (u32)port_cycles();
    i = 0;
    while (i < PERF_N) {
        (void)os_sem_post(&s);
        (void)os_sem_pend(&s, 0u);
        i++;
    }
    t1 = (u32)port_cycles();
    g_sem = t1 - t0;

    (void)os_queue_init(&q, &g_qstore[0], 8u);
    t0 = (u32)port_cycles();
    i = 0;
    while (i < PERF_N) {
        (void)os_queue_put(&q, &v, 0u);
        (void)os_queue_get(&q, 0u);
        i++;
    }
    t1 = (u32)port_cycles();
    g_queue = t1 - t0;

    os_heap_init(&h, arena, (u32)sizeof(arena));
    t0 = (u32)port_cycles();
    i = 0;
    while (i < PERF_N) {
        p = os_heap_alloc(&h, 32u);
        g_sink = (u32)p;
        (void)os_heap_free(&h, p);
        i++;
    }
    t1 = (u32)port_cycles();
    g_heap = t1 - t0;

    t0 = (u32)port_cycles();
    i = 0;
    while (i < PERF_N) {
        os_sched_tick();
        i++;
    }
    t1 = (u32)port_cycles();
    g_tick = t1 - t0;

    os_task_exit();
}

static int run(void) {
    int id = os_task_create("bench", bench, 0, 1u, 4096u);

    if (id <= 0) {
        port_puts("FAIL: perf create\n");
        return 1;
    }
    os_task_start();
    report("yield", g_yield, PERF_N);
    report("sem_post+pend", g_sem, PERF_N);
    report("queue_put+get", g_queue, PERF_N);
    report("heap_alloc+free", g_heap, PERF_N);
    report("sched_tick", g_tick, PERF_N);
    port_puts("PERF done\n");
    return 0;
}

#if defined(C6OS_BARE)
void os_main(void) {
    port_init();
    port_delay_ms(1000);
    (void)run();
    port_bare_exit(0u);
}
#elif defined(C6OS_S3)
void os_main(void) {
    port_init();
    port_delay_ms(1000);
    (void)run();
    port_reboot();
}
#else
int main(void) {
    return run();
}
#endif
