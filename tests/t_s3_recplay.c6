/* t_s3_recplay.c6 —— BOOT 按键控制的"录音 → 循环播放"演示（真板）。
 *
 *   按一下 BOOT：麦克风（I2S1 + GDMA）录音，录满缓冲自动转入循环播放；
 *                录音途中再按一下就提前结束并播放。
 *   播放中按 BOOT：停下播放，重新录一段 —— 形成"录 → 放 → 录 → 放"循环。
 *
 * 音频格式（照上游 NoAudioCodecSimplex，**真板验证过能出声、速度也对**）：
 *   32bit 槽 / 单声道（tx_mono + tx_chan_equal）/ 左对齐 / 16kHz。
 *   麦克风录下来的 32bit 缓冲不做任何转换直接喂给喇叭，录放严格同速。
 *
 * 为什么只录 ~2.6 秒而不是 5 秒：这块板可用 .bss 只有约 231KB —— DRAM 在
 * 0x3FCD9500 之后有一小段"密集读写会把 CPU 挂住"的坏区，.bss 盖过去会在启动
 * 清 .bss 时静默死机（串口全空 + 黑屏），见 docs/todo.md。16kHz×32bit 下
 * 2.6 秒就把这段用完了；而麦克风在 8kHz 又不肯出数据，所以不能靠降采样率省。
 * 5 秒必须用 16bit 采样（160KB）：喇叭侧要换成 16bit 槽（s3_i2s_init16，
 * 已写好但真板上播放会卡住，待查），麦克风侧要分块抓音再压位。
 *
 * 屏幕：不用整屏帧缓冲（115KB 会把录音缓冲挤掉），只用一条 240×16 的文字带
 * （7.5KB）；进度条用 s3_lcd_fill_rect 直接画。
 *
 * 串口：逐步初始化标记 + 录音统计 + 两个 GDMA 通道的 int_raw。
 * 想不按键就验证整条通路：编译时加 S3_C6FLAGS=-DRECPLAY_AUTO=1。
 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/gfx.h"

#define W          240u
#define H          240u
#define BAND_H     16u                         /* 文字带高度（一行 16px 字模） */
#define RATE       16000u
#define REC_SEG    4092u                       /* 与 port/s3/i2s.c 的段大小一致 */
#ifndef REC_SEGS_CFG
#define REC_SEGS_CFG 41u                       /* 41 × 4092 = 167772 字节 ≈ 2.62 秒 */
#endif
#define REC_SEGS   REC_SEGS_CFG
#define REC_BYTES  (REC_SEG * REC_SEGS)

#ifndef RECPLAY_AUTO
#define RECPLAY_AUTO 0
#endif

void s3_btn_init(void);
void s3_btn_poll(void);
u32 s3_btn_take_event(u32 i);
u32 s3_btn_pressed(u32 i);

void s3_lcd_init(void);
void s3_lcd_bl(u32 on);
void s3_lcd_fill(u16 color);
void s3_lcd_fill_rect(u32 x, u32 y, u32 w, u32 h, u16 color);
void s3_lcd_window(u32 x, u32 y, u32 w, u32 h);
void s3_lcd_pixels(const u16 *px, u32 n);
void s3_lcd_delay(u32 n);

void s3_i2s_init(u32 sample_rate);            /* 喇叭：32bit 槽 */
void s3_i2s_rx_init(u32 rate);                /* 麦克风：32bit 槽 */
u32  s3_i2s_rx_capture(void *buf, u32 bytes);
void s3_i2s_rx_stop(void);
u32  s3_i2s_rx_filled(void);
void s3_i2s_play(const void *buf, u32 bytes, u32 loop);
void s3_i2s_play_stop(void);
u32  s3_i2s_tx_int_raw(void);
u32  s3_i2s_rx_int_raw(void);

#define ST_IDLE 0u
#define ST_REC  1u
#define ST_PLAY 2u

static u16 g_band[W * BAND_H];            /* 文字带（不初始化 → .bss） */
static OsGfx g;
static u32 g_rec[REC_BYTES / 4u];         /* 32bit 一帧（单声道左槽） */
static u32 g_state = ST_IDLE;
static u32 g_target;                      /* 本次录音的目标字节数 */
static u32 g_frames;                      /* 已录/已放帧数 */
static u32 g_peak;
static u32 g_t0;                          /* 进入当前状态的周期数 */
static u32 g_drawn_state = 0xFFFFFFFFu;

static void pstr(const char *s) { while (*s != '\0') { port_putc(*s); s++; } }

static void pu32(u32 v)
{
    char b[12] = {0};
    int i = 0;

    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v = v / 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

static void u2s(char *out, u32 v)
{
    char tmp[12] = {0};
    int n = 0;
    int i = 0;

    if (v == 0u) { out[0] = '0'; out[1] = '\0'; return; }
    while (v > 0u) { tmp[n] = (char)('0' + (v % 10u)); n++; v = v / 10u; }
    while (n > 0) { n--; out[i] = tmp[n]; i++; }
    out[i] = '\0';
}

/* 在文字带里写一行字，再整条贴到屏幕的 y 行。
 * 用 window+pixels（源/目标分离）：s3_lcd_blit_rect 的 x/y 同时是 fb 内源坐标，
 * 拿屏幕行号当源坐标会越界读到 DRAM 外 → 取指异常 → 静默死机。 */
static void band_text(const char *s, u32 y, u16 color)
{
    os_gfx_fill_rect(&g, 0, 0, (int)W, (int)BAND_H, 0x0000u);
    os_gfx_text16(&g, 2, 0, s, color);
    s3_lcd_window(0u, y, W, BAND_H);
    s3_lcd_pixels(g_band, W * BAND_H);
}

static void band_kv(const char *prefix, u32 v, u32 y, u16 color)
{
    char b[24] = {0};
    char n[12] = {0};
    int i = 0;
    int k = 0;

    while (prefix[i] != '\0' && i < 12) { b[i] = prefix[i]; i++; }
    u2s(n, v);
    while (n[k] != '\0' && i < 22) { b[i] = n[k]; i++; k++; }
    b[i] = '\0';
    band_text(b, y, color);
}

/* 32bit 左槽样本 → 绝对值（按高 16 位当 s16 看，够判断音量） */
static u32 abs16(u32 frame)
{
    u32 v = frame >> 16;

    if ((v & 0x8000u) != 0u) { return 0x10000u - (v & 0xFFFFu); }
    return v;
}

static void rec_stats(void)
{
    u32 i = 0;
    u32 sum = 0;
    u32 peak = 0;

    while (i < g_frames) {
        u32 a = abs16(g_rec[i]);
        if (a > peak) { peak = a; }
        sum = sum + a;
        i++;
    }
    g_peak = peak;
    pstr("rec stats: frames=");
    pu32(g_frames);
    pstr(" peak=");
    pu32(peak);
    pstr(" avg=");
    pu32((g_frames != 0u) ? (sum / g_frames) : 0u);
    pstr(" s0=");
    pu32(g_rec[0]);
    pstr(" wall_ms=");
    pu32(((u32)port_cycles() - g_t0) / 40000u);     /* CPU 40MHz → 微秒/1000 */
    pstr("\n");
}

static void draw_static(void)
{
    s3_lcd_fill(0x0000u);
    band_text("C6OS REC / LOOP", 0u, 0x07FFu);
    band_text("mic=I2S1 spk=I2S0 16kHz", 20u, 0x7BEFu);
    band_text("BOOT: rec -> loop", 200u, 0xF81Fu);
}

static void flush_state(void)
{
    u16 color = 0xFFFFu;
    const char *s = "IDLE";

    if (g_state == ST_REC) { color = 0xF800u; s = "REC"; }
    if (g_state == ST_PLAY) { color = 0x07E0u; s = "PLAY LOOP"; }

    band_text(s, 60u, color);
    band_kv("frames=", g_frames, 80u, 0xFFE0u);
    if (g_state == ST_PLAY) { band_kv("peak=", g_peak, 100u, 0xFFFFu); }
    g_drawn_state = g_state;
}

static void flush_bar(void)
{
    u32 pct = 0;
    u32 w = 0u;

    if (g_state == ST_REC) {
        if (g_target != 0u) { pct = (s3_i2s_rx_filled() * 100u) / g_target; }
    } else if (g_state == ST_PLAY) {
        u32 el = ((u32)port_cycles() - g_t0) / 40u;                /* 微秒(40MHz) */
        u32 total = (g_frames * 1000000u) / RATE;
        if (total != 0u) { pct = (el % total) * 100u / total; }
    }
    if (pct > 100u) { pct = 100u; }
    w = (W - 16u) * pct / 100u;

    s3_lcd_fill_rect(8u, 130u, W - 16u, 18u, 0x2104u);
    if (w != 0u) {
        s3_lcd_fill_rect(8u, 130u, w, 18u,
                         (g_state == ST_REC) ? 0xF800u : 0x07E0u);
    }
    band_kv("progress=", pct, 156u, 0xFFFFu);
}

static void rec_start(void)
{
    u32 got = s3_i2s_rx_capture(g_rec, REC_BYTES);

    g_target = got;
    g_frames = 0u;
    g_peak = 0u;
    g_state = ST_REC;
    g_t0 = (u32)port_cycles();
    pstr("rec start target=");
    pu32(got);
    pstr(" rx_int=");
    pu32(s3_i2s_rx_int_raw());
    pstr("\n");
    flush_state();
    flush_bar();
}

static void rec_stop_to_play(void)
{
    u32 filled = s3_i2s_rx_filled();
    u32 min = REC_SEG;

    s3_i2s_rx_stop();
    if (filled < min) { filled = 0u; }
    if (filled == 0u) {
        pstr("rec empty -> idle\n");
        g_state = ST_IDLE;
        flush_state();
        flush_bar();
        return;
    }

    g_frames = filled / 4u;
    rec_stats();
    s3_i2s_play(g_rec, filled, 1u);
    pstr("play loop bytes=");
    pu32(filled);
    pstr(" tx_int=");
    pu32(s3_i2s_tx_int_raw());
    pstr(" rx_int=");
    pu32(s3_i2s_rx_int_raw());
    pstr("\n");

    g_state = ST_PLAY;
    g_t0 = (u32)port_cycles();
    flush_state();
    flush_bar();
}

static void play_stop(void)
{
    s3_i2s_play_stop();
    pstr("play stop tx_int=");
    pu32(s3_i2s_tx_int_raw());      /* 播放期间 TX 的 DMA 中断＝数据真的推出去了 */
    pstr("\n");
}

void os_main(void)
{
    u32 btn = 0;
    u32 now = 0;
    u32 last_bar = 0;

    pstr("c6os rec/play: BOOT -> record, again -> loop playback\n");
    pstr("rate=");
    pu32(RATE);
    pstr(" rec_bytes=");
    pu32(REC_BYTES);
    pstr(" auto=");
    pu32(RECPLAY_AUTO);
    pstr("\n");

    pstr("init btn..\n");
    s3_btn_init();
    pstr("init lcd..\n");
    s3_lcd_init();
    s3_lcd_bl(1u);
    pstr("init gfx..\n");
    os_gfx_init(&g, g_band, W, BAND_H);
    pstr("init i2s spk..\n");
    s3_i2s_init(RATE);
    pstr("init i2s mic..\n");
    s3_i2s_rx_init(RATE);
    pstr("init done\n");

    draw_static();
    flush_state();
    flush_bar();
    pstr("first screen done\n");

    if (RECPLAY_AUTO != 0u) { rec_start(); }

    for (;;) {
        s3_btn_poll();
        btn = s3_btn_take_event(0u);            /* 0 = BOOT(GPIO0) */

        if (g_state == ST_IDLE) {
            if (btn != 0u) { rec_start(); }
        } else if (g_state == ST_REC) {
            g_frames = s3_i2s_rx_filled() / 4u;
            if (btn != 0u || s3_i2s_rx_filled() >= g_target) {
                rec_stop_to_play();
            }
        } else {                                /* ST_PLAY：无限循环播放中 */
            if (btn != 0u) {
                play_stop();
                rec_start();
            }
        }

        if (RECPLAY_AUTO != 0u && g_state == ST_PLAY &&
            ((u32)port_cycles() - g_t0) > 40u * 3000000u) {   /* 放 3 秒 */
            play_stop();
            rec_start();
        }

        now = (u32)port_cycles();
        if (g_state != g_drawn_state || (now - last_bar) > 40u * 200000u) {
            last_bar = now;
            if (g_state == ST_REC) { g_frames = s3_i2s_rx_filled() / 4u; }
            flush_state();
            flush_bar();
        }
        s3_lcd_delay(4000u);                    /* ≈0.25ms 采一次按键 */
    }
}
