#include "c6os/task.h"
#include "c6os/mutex.h"
#include "c6os/sem.h"
#include "c6os/port.h"

static OsMutex m1 = {0};
static OsMutex m2 = {0};
static OsSem go = {0};
static u32 idL = 0;
static u32 idM = 0;
static u32 idH = 0;
static u32 p3_ok = 0;
static u32 p1_ok = 0;
static u32 l_done = 0;
static u32 m_done = 0;
static u32 h_done = 0;

static void low(void *arg) {
    os_mutex_pend(&m1, 0);
    os_sem_post(&go);
    os_task_yield();
    if (os_task_get(os_task_self())->prio == 1u) {
        p1_ok = 1u;
    }
    os_mutex_post(&m1);
    l_done = 1u;
}

static void mid(void *arg) {
    os_mutex_pend(&m2, 0);
    os_sem_post(&go);
    os_mutex_pend(&m1, 0);
    os_mutex_post(&m2);
    os_mutex_post(&m1);
    m_done = 1u;
}

static void high(void *arg) {
    os_sem_post(&go);
    os_mutex_pend(&m2, 0);
    os_mutex_post(&m2);
    h_done = 1u;
}

static void ctl(void *arg) {
    os_task_resume(idL);
    os_sem_pend(&go, 10u);
    os_task_resume(idM);
    os_sem_pend(&go, 10u);
    if (os_task_get(idL)->prio == 3u) {
        p3_ok = 1u;
    }
    os_task_resume(idH);
    os_sem_pend(&go, 10u);
}

int main(void) {
    int k = 0;

    if (os_mutex_init(&m1) != 0 || os_mutex_init(&m2) != 0 ||
        os_sem_init(&go, 0, 8) != 0) {
        return 1;
    }
    idL = (u32)os_task_create("L", low, 0, 5u, 8192u);
    idM = (u32)os_task_create("M", mid, 0, 3u, 8192u);
    idH = (u32)os_task_create("H", high, 0, 1u, 8192u);
    k = os_task_create("K", ctl, 0, 0u, 8192u);
    if (idL == 0u || idM == 0u || idH == 0u || k <= 0) {
        return 2;
    }
    os_task_suspend(idL);
    os_task_suspend(idM);
    os_task_suspend(idH);
    os_task_start();
    if (p3_ok != 1u || p1_ok != 1u || l_done != 1u || m_done != 1u || h_done != 1u) {
        port_puts("FAIL: pi chain\n");
        return 3;
    }
    port_puts("PASS: PI chain\n");
    return 0;
}
