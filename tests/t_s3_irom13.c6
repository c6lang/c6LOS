/* t_s3_irom13.c6 —— 全部要素齐备的最终序列：
 * 关双 cache -> 修 SPI_MEM 时钟/控制(按 IDF 参照值) -> MMU 表项补 valid 位
 * -> 开双 cache -> ICACHE INVALIDATE(bit0=INVALIDATE_ENA, bit1=DONE) -> 数据读 -> 取指
 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

void s3_win_call_log(const char *s);
u32  s3_win_call_flash42(void);

void os_main(void)
{
    u32 v = 0u, guard = 0u;

    s3_beacon(0u, 0xB0000013u);

    os_reg_wr(0x600C4060u, 0x0u);          /* ICACHE off */
    os_reg_wr(0x600C4000u, 0x0u);          /* DCACHE off */

    os_reg_wr(0x60002014u, 0x00030103u);   /* SPI_MEM_CLOCK  按 IDF */
    os_reg_wr(0x60002008u, 0x00608000u);   /* SPI_MEM_CTRL   按 IDF */

    os_reg_wr(0x600C500Cu, 0x4003u);       /* MMU[3] = valid|页3 */
    os_reg_wr(0x600C5000u, 0x4002u);       /* MMU[0] = valid|页2 */

    os_reg_wr(0x600C4000u, 0x1u);          /* DCACHE on */
    os_reg_wr(0x600C4060u, 0x1u);          /* ICACHE on */

    /* ICACHE invalidate：bit0 = INVALIDATE_ENA，bit1 = DONE */
    os_reg_wr(0x600C4088u, 0x1u);
    while (guard < 100000u) {
        if ((os_reg_rd(0x600C4088u) & 0x2u) != 0u) { break; }
        guard = guard + 1u;
    }
    s3_beacon(3u, (os_reg_rd(0x600C4088u) & 0x2u) | (guard << 8));

    v = *(volatile u32 *)0x42030000u;      /* 数据读，期望 0x7b004136 */
    s3_beacon(2u, v);

    v = s3_win_call_flash42();             /* 取指，期望 42 */
    s3_beacon(1u, 0xF1000000u | (v & 0xFFu));
    for (;;) { }
}
