/* 对照：显式调用 ROM 的 Cache_Enable_ICache，再取指 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
extern const u32 s3_flash_rodata_probe;
extern u32 s3_win_call_flash42(void);
extern u32 s3_win_cache_enable(void);
void os_main(void)
{
    s3_beacon(0u, 0xB00001D0u);
    s3_beacon(1u, s3_win_cache_enable());          /* ROM Cache_Enable_ICache */
    s3_beacon(2u, *(volatile u32 *)0x600C4060u);   /* ICACHE_CTRL after */
    s3_beacon(3u, s3_win_call_flash42());          /* 取指，期望 42 */
    for (;;) { }
}
