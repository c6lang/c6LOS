/* t_s3_irom11.c6 —— 验证 SPI_MEM 时钟/控制寄存器能否写入生效，然后再试数据读。 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

void s3_win_call_log(const char *s);
static void pstr(const char *s) { s3_win_call_log(s); }
static void phex(u32 v)
{
    char b[11] = {0}; int i = 2; int sh = 28; const char *h = "0123456789abcdef";
    b[0] = '0'; b[1] = 'x';
    while (sh >= 0) { b[i] = h[(v >> (u32)sh) & 0xFu]; i++; sh -= 4; }
    b[10] = '\0'; pstr(b);
}

void os_main(void)
{
    u32 v = 0u;

    s3_beacon(0u, 0xB0000011u);
    s3_beacon(1u, os_reg_rd(0x60002014u));      /* CLOCK 改前 */
    s3_beacon(2u, os_reg_rd(0x60002008u));      /* CTRL  改前 */

    os_reg_wr(0x60002014u, 0x00030103u);
    os_reg_wr(0x60002008u, 0x00608000u);

    s3_beacon(3u, os_reg_rd(0x60002014u));      /* CLOCK 改后回读 */

    /* MMU 表项补 valid 位，然后数据读 */
    os_reg_wr(0x600C500Cu, 0x4003u);
    os_reg_wr(0x600C5000u, 0x4002u);
    v = *(volatile u32 *)0x42030000u;
    s3_beacon(1u, v);                           /* 期望 0x7b004136 */
    for (;;) { }
}
