/* 按 IDF 做法调 ROM rom_config_instruction_cache_mode(32KB, 8-way, 32B) 后再读 IROM */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
u32 s3_win_call_config_icache_mode(u32 size, u32 ways, u32 line);
u32 s3_win_call_cache_invalidate_addr(u32 addr, u32 size);
u32 s3_win_call_flash42(void);
void os_main(void)
{
    u32 v = 0u;
    s3_beacon(0u, 0xB00000D0u);
    s3_beacon(3u, os_reg_rd(0x600C4060u));            /* 改前 ICACHE_CTRL */

    s3_win_call_config_icache_mode(32768u, 8u, 32u);  /* 按 IDF 的模式 */
    s3_win_call_cache_invalidate_addr(0x42030000u, 0x10000u);

    s3_beacon(2u, os_reg_rd(0x600C4060u));            /* 改后 ICACHE_CTRL 期望 0x0b */
    v = *(volatile u32 *)0x42030000u;
    s3_beacon(1u, v);                                  /* 期望 0x7b004136 */
    for (;;) { }
}
