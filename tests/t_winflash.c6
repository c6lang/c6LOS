/* 决定性测试：flash 里的 windowed 函数（entry 入口）能否执行 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/flash.h"
extern u32 s3_win_call_flash_entry_test(u32 x);
void os_main(void)
{
    u32 v = 0u;
    s3_beacon(0u, 0xB0000120u);
    os_icache_enable();
    v = s3_win_call_flash_entry_test(35u);   /* 期望 42 */
    s3_beacon(1u, v);
    for (;;) { }
}
