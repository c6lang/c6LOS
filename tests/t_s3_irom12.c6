/* t_s3_irom12.c6 —— 完整干净序列：
 * 关双 cache -> 按 IDF 参照值修 SPI_MEM 时钟/控制 -> 写带 valid 位的 MMU 表 -> 开 cache -> 数据读
 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"

void s3_win_call_log(const char *s);
u32  s3_win_call_flash42(void);
static void pstr(const char *s) { s3_win_call_log(s); }

void os_main(void)
{
    u32 v = 0u;

    s3_beacon(0u, 0xB0000012u);

    /* 1) 关双 cache */
    os_reg_wr(0x600C4060u, 0x0u);
    os_reg_wr(0x600C4000u, 0x0u);

    /* 2) SPI flash 控制器：按 IDF 参照 app 运行态的值 */
    os_reg_wr(0x60002014u, 0x00030103u);   /* SPI_MEM_CLOCK */
    os_reg_wr(0x60002008u, 0x00608000u);   /* SPI_MEM_CTRL  */

    /* 3) MMU 表项带 valid 位（bit14） */
    os_reg_wr(0x600C500Cu, 0x4003u);       /* IROM 页3 -> flash 0x30000 */
    os_reg_wr(0x600C5000u, 0x4002u);       /* DROM 页0 -> flash 0x20000 */

    /* 4) 开 cache */
    os_reg_wr(0x600C4000u, 0x1u);
    os_reg_wr(0x600C4060u, 0x1u);

    s3_beacon(2u, os_reg_rd(0x60002014u));  /* 确认时钟写入生效 */
    s3_beacon(3u, os_reg_rd(0x600C500Cu));  /* 确认表项 */

    /* 5) 数据读 */
    v = *(volatile u32 *)0x42030000u;
    s3_beacon(1u, v);                       /* 期望 0x7b004136 */

    /* 6) 再试取指 */
    v = s3_win_call_flash42();
    s3_beacon(1u, 0xF1000000u | (v & 0xFFu));
    for (;;) { }
}
