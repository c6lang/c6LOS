#include "los/los_queue.h"
#include "los/los_mux.h"
#include "los/los_event.h"
#include "los/los_task.h"
#include "c6os/port.h"

int main(void) {
    UINT32 qid = 0;
    UINT32 mid = 0;
    UINT32 eid = 0;
    UINT32 v = 42;
    UINT32 out = 0;
    UINT32 bits = 0;

    if (LOS_QueueCreate("q", 8, &qid, 0, 4) != LOS_OK) {
        return 1;
    }
    if (LOS_QueueUsed(qid) != 0u) {
        return 2;
    }
    if (LOS_QueueWrite(qid, &v, 4, 0) != LOS_OK) {
        return 3;
    }
    if (LOS_QueueUsed(qid) != 1u) {
        return 4;
    }
    if (LOS_QueueRead(qid, &out, 4, 0) != LOS_OK) {
        return 5;
    }
    if (out != 42u) {
        return 6;
    }
    {
        UINT32 wlen = 4;
        UINT32 rlen = 4;
        out = 0;
        if (LOS_QueueWriteCopy(qid, &v, wlen, 0) != LOS_OK) {
            return 19;
        }
        if (LOS_QueueReadCopy(qid, &out, &rlen, 0) != LOS_OK ||
            rlen != 4u || out != 42u) {
            return 20;
        }
    }
    if (LOS_QueueDelete(qid) != LOS_OK) {
        return 7;
    }

    if (LOS_MuxCreate(&mid) != LOS_OK) {
        return 8;
    }
    if (LOS_MuxPend(mid, 0) != LOS_OK) {
        return 9;
    }
    if (LOS_MuxPost(mid) != LOS_OK) {
        return 10;
    }
    if (LOS_MuxDelete(mid) != LOS_OK) {
        return 11;
    }

    if (LOS_EventInit(&eid) != LOS_OK) {
        return 12;
    }
    if (LOS_EventWrite(eid, 2) != LOS_OK) {
        return 13;
    }
    if (LOS_EventPoll(eid, 3, LOS_WAITMODE_OR) != 2u) {
        return 21;
    }
    bits = LOS_EventRead(eid, 3, LOS_WAITMODE_OR, 0);
    if (bits != 2u) {
        return 14;
    }
    if (LOS_EventClear(eid, 2) != LOS_OK) {
        return 15;
    }
    if (LOS_EventDelete(eid) != LOS_OK) {
        return 16;
    }
    LOS_TaskLock();
    LOS_TaskUnlock();
    if (LOS_TaskPriGet(999u) != 0xFFFFFFFFu) {
        return 17;
    }
    if (LOS_TaskPriSet(999u, 1u) == LOS_OK) {
        return 18;
    }
    {
        TaskSwitchInfo ti = {0};
        if (LOS_TaskSwitchInfoGet(&ti) != LOS_OK || LOS_TaskSwitchInfoGet(0) == LOS_OK) {
            return 19;
        }
    }
    port_puts("PASS: LOS_Queue/Mux/Event\n");
    return 0;
}
