/* t_s3_irom5.c6 —— 正确顺序：映射 -> 清 I-cache(ROM,经孤岛) -> 使能 I-cache(ROM) -> 执行 flash 里的函数。
 * 结果写信标：slot0 = 0xF1xxxxxx(低字节是返回值 42)；不打印（避免干扰）。 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
#include "c6os/flash.h"

void s3_win_call_log(const char *s);
u32 s3_win_call_cache_enable(void);
u32 s3_win_call_cache_invalidate(void);
u32 s3_win_call_flash42(void);

static void pstr(const char *s) { s3_win_call_log(s); }

static void phex(u32 v)
{
    char b[11] = {0};
    int i = 2;
    int sh = 28;
    const char *h = "0123456789abcdef";

    b[0] = '0'; b[1] = 'x';
    while (sh >= 0) { b[i] = h[(v >> (u32)sh) & 0xFu]; i++; sh -= 4; }
    b[10] = '\0';
    pstr(b);
}

void os_main(void)
{
    u32 v = 0u;

    s3_beacon(0u, 0xB0000002u);
    (void)os_flash_map(0x100000u, 0x42100000u, 0x10000u, OS_FLASH_IROM);
    s3_beacon(2u, os_flash_mmu_entry(0x42100000u));

    s3_beacon(3u, 0x1CAC0001u);       /* 映射后 */
    s3_win_call_cache_enable();       /* ROM Cache_Enable_ICache */
    s3_beacon(3u, 0x1CAC0002u);       /* enable 返回了 */

    v = s3_win_call_flash42();
    s3_beacon(1u, 0xF1000000u | (v & 0xFFu));
    for (;;) { }
}
