#include "c6os/types.h"
#include "c6os/task.h"
#include "c6os/sem.h"
#include "c6os/port.h"

extern void s3_irq_set_hook(void (*fn)(void));
extern u32 s3_irq_cc(void);
extern u32 s3_ccount_now(void);

static OsSem g_sem;
static u32 g_max = 0;
static u32 g_n = 0;
static u32 g_sum = 0;
static u32 g_min = 0xFFFFFFFFu;

static void put_u32(u32 v) {
    char b[12] = {0};
    int i = 0;

    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v /= 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

static void tick_hook(void) {
    (void)os_sem_post(&g_sem);
}

static void worker(void *arg) {
    u32 i = 0;

    os_task_delay(5u);
    while (i < 100u) {
        int r = os_sem_pend(&g_sem, 10000u);

        if (r == 0) {
            u32 d = s3_ccount_now() - s3_irq_cc();

            if (d > g_max) { g_max = d; }
            if (d < g_min) { g_min = d; }
            g_sum += d;
            g_n++;
        }
        i++;
    }
    port_puts("isr->task min=");
    put_u32(g_min);
    port_puts(" avg=");
    put_u32(g_n != 0u ? g_sum / g_n : 0u);
    port_puts(" max=");
    put_u32(g_max);
    port_puts(" cycles (max ");
    put_u32(g_max / 40u);
    port_puts(" us) n=");
    put_u32(g_n);
    port_puts("\n");
    if (g_n == 100u && (g_sum / g_n) < 4000u) {
        port_puts("PASS: s3 irq latency\n");
    } else {
        port_puts("FAIL: s3 irq latency\n");
    }
}

void os_main(void) {
    port_init();
    port_puts("c6os s3 irq latency test\n");
    if (os_sem_init(&g_sem, 0u, 0xFFu) != 0) {
        port_puts("FAIL: sem\n");
        return;
    }
    if (os_task_create("w", worker, 0, 1u, 4096u) <= 0) {
        port_puts("FAIL: create\n");
        return;
    }
    s3_irq_set_hook(tick_hook);
    os_task_start();
}
