/* t_s3_cmdphase.c6 —— 用"命令相位 + 数据相位"发一次事务（IDF esp_lcd 就是这么
 * 发 LCD 命令的：lcd_cmd_bits=8 → SPI 硬件的 command phase），再数 SCLK/MOSI
 * 边沿，看硬件 SPI 的时钟是否只有在这种事务结构下才会输出。
 */

#include "c6os/port.h"

#define PCNT_BASE 0x60017000u
#define SPI2 0x60024000u

void s3_lcd_init(void);
void s3_lcd_use_bitbang(u32 on);
u32 s3_reg32(u32 addr);
void s3_reg_wr(u32 addr, u32 v);
void s3_lcd_delay(u32 n);

static void puts_(const char *s)
{
    while (*s != '\0') { port_putc(*s); s++; }
}

static void put_u32_(u32 v)
{
    char b[12] = {0};
    int i = 0;
    if (v == 0u) { port_putc('0'); return; }
    while (v > 0u) { b[i] = (char)('0' + (v % 10u)); i++; v = v / 10u; }
    while (i > 0) { i--; port_putc((int)b[i]); }
}

static void pcnt_init(void)
{
    s3_reg_wr(0x600C0018u, s3_reg32(0x600C0018u) | (1u << 10));
    s3_reg_wr(0x600C0020u, s3_reg32(0x600C0020u) & ~(1u << 10));
    s3_reg_wr(PCNT_BASE + 0x00u, (1u << 18));
    s3_reg_wr(PCNT_BASE + 0x04u, 0u);
    s3_reg_wr(PCNT_BASE + 0x08u, 0u);
}

static void pcnt_map(u32 pin)
{
    s3_reg_wr(0x60004000u + 0x154u + 4u * 33u, (pin & 0x3Fu) | (1u << 6));
    s3_reg_wr(0x60009000u + 0x04u + 4u * pin, s3_reg32(0x60009000u + 0x04u + 4u * pin) | (1u << 9));
}

/* 一次事务：command 相位 8 bit + data 相位 64 字节 */
static void xfer(u32 user, u32 user2)
{
    u32 i = 0;

    for (i = 0; i < 16u; i++) { s3_reg_wr(SPI2 + 0x98u + 4u * i, 0x55555555u); }
    s3_reg_wr(SPI2 + 0x0Cu, (9u << 18) | (63u << 12) | (31u << 6) | 31u);  /* 125kHz */
    s3_reg_wr(SPI2 + 0x18u, user2);
    s3_reg_wr(SPI2 + 0x10u, user);
    s3_reg_wr(SPI2 + 0x1Cu, 64u * 8u - 1u);
    s3_reg_wr(SPI2 + 0x00u, (1u << 23));
    while ((s3_reg32(SPI2 + 0x00u) & (1u << 23)) != 0u) { }
    s3_reg_wr(SPI2 + 0x00u, (1u << 24));
    while ((s3_reg32(SPI2 + 0x00u) & (1u << 24)) != 0u) { }
}

static void case_(const char *name, u32 user, u32 user2)
{
    u32 sclk = 0;
    u32 mosi = 0;

    pcnt_map(9u);
    s3_reg_wr(PCNT_BASE + 0x60u, 1u);
    s3_reg_wr(PCNT_BASE + 0x60u, 0u);
    xfer(user, user2);
    sclk = s3_reg32(PCNT_BASE + 0x30u) & 0xFFFFu;

    pcnt_map(10u);
    s3_reg_wr(PCNT_BASE + 0x60u, 1u);
    s3_reg_wr(PCNT_BASE + 0x60u, 0u);
    xfer(user, user2);
    mosi = s3_reg32(PCNT_BASE + 0x30u) & 0xFFFFu;

    puts_(name);
    puts_(" sclk=");
    put_u32_(sclk);
    puts_(" mosi=");
    put_u32_(mosi);
    puts_("\n");
}

void os_main(void)
{
    puts_("c6os cmd phase test\n");
    s3_lcd_use_bitbang(0u);          /* 硬件 SPI + 矩阵输出 */
    s3_lcd_init();
    pcnt_init();

    /* 只有数据相位（之前测过：SCLK=0） */
    case_("data only     ", 0x08000200u, 0x00000000u);
    /* 命令相位（bitlen 8）+ 数据相位 —— IDF esp_lcd 的做法 */
    case_("cmd+data      ", 0x88000200u, 0x7800002Au);
    /* 命令相位 + 数据相位 + dummy */
    case_("cmd+dummy+data", 0xA8000200u, 0x7800002Au);

    for (;;) {
        s3_lcd_delay(4000000u);
        puts_(".");
    }
}
