/* t_s3_abic.c6 —— windowed ABI 最小验证（第 2 版）
 *
 * 第 1 版（带 pstr/pu32/slen/add3）在 windowed 下一行都打不出来。这一版先从
 * 最简单开始：os_main 里**不调用任何自己的函数**，直接 port_putc 打一串写死的
 * 字符；然后逐级加：port_puts → 带指针参数的函数 → 带 u32 参数的函数。
 * 用串口看到几行，就知道 windowed 断在第几层。
 */
#include "c6os/types.h"
#include "c6os/port.h"

void s3_lcd_delay(u32 n);
void port_puts(const char *s);
u32 s3_win_call_add(u32 a, u32 b);   /* 走 ABI 桥调 windowed 孤岛里的函数 */
u32 s3_win_call_phy_cal(void);       /* 桥调 windowed 孤岛 → libphy.a */

static void put1(const char *s) { while (*s != '\0') { port_putc(*s); s++; } }

static u32 add2(u32 a, u32 b) { return a + b; }

void os_main(void)
{
    /* 第 1 级：完全内联，只调 port_putc */
    port_putc('A');
    port_putc('B');
    port_putc('C');
    port_putc('\n');

    /* 第 2 级：调用运行库 port_puts（普通 C 函数，带指针参数） */
    port_puts("L2 port_puts ok\n");

    /* 第 3 级：先测 u32 参数（不涉及指针/字符串） */
    port_putc('L');
    port_putc('3');
    port_putc('=');
    port_putc((int)('0' + add2(1u, 2u)));
    port_putc('\n');

    /* 第 4 级：再测自己写的、带指针参数的函数 */
    put1("L4 put1 ok\n");

    /* 第 5 级：跨 ABI 桥 —— 调 windowed 孤岛里的 s3_win_add(1,2) = 1003 */
    port_puts("L5 win=");
    {
        u32 v = s3_win_call_add(1u, 2u);
        port_putc((int)('0' + (v / 1000u)));
        port_putc((int)('0' + ((v / 100u) % 10u)));
        port_putc((int)('0' + ((v / 10u) % 10u)));
        port_putc((int)('0' + (v % 10u)));
    }
    port_putc('\n');

    port_puts("L6 phy_cal=");
    {
        u32 v = s3_win_call_phy_cal();
        if (v == 0u || v == 0xFFFFFFFFu) {
            port_puts("(suspicious)");
        }
        port_putc((int)('0' + ((v >> 4) & 0xFu)));
        port_putc((int)('0' + (v & 0xFu)));
    }
    port_putc('\n');

    port_puts("abic done\n");

    for (;;) {
        s3_lcd_delay(4000000u);
    }
}
