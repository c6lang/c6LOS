/* 验证标准库修复：os_icache_enable() 之后 IROM 应该完全可用 */
#include "c6os/types.h"
#include "c6os/port.h"
#include "c6os/reg.h"
#include "c6os/flash.h"
u32 s3_win_call_flash42(void);
void os_main(void)
{
    u32 v = 0u;
    s3_beacon(0u, 0xB00000F0u);

    os_icache_enable();                              /* 标准库接口 */

    s3_beacon(2u, os_reg_rd(0x600C4060u));           /* 期望 0x0f */
    s3_beacon(3u, *(volatile u32 *)0x42030000u);     /* 数据读，期望 0x7b004136 */
    v = s3_win_call_flash42();                       /* 取指执行，期望 42 */
    s3_beacon(1u, 0xF1000000u | (v & 0xFFu));
    for (;;) { }
}
